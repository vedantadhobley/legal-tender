{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculation-fixture-manifest.schema.json",
  "title": "Legal Tender calculation fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "calculation_contract", "transformation", "fixtures"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "calculation_contract": {"type": "string", "format": "uri-reference"},
    "transformation": {"type": "string", "minLength": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "input_paths", "scenarios"],
        "properties": {
          "path": {"type": "string", "format": "uri-reference"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "input_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri-reference"}
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
