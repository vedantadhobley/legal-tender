{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/candidate-itemized-individual-receipts/v1/manifest.schema.json",
  "title": "Published candidate itemized-individual receipt calculation set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "calculation_set_id", "calculation",
    "calculation_version", "decision_schema_version", "result_schema_version", "cycle",
    "source_release_id", "input_fact_sets", "run_id", "state",
    "published_at", "counts", "decisions", "results", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.candidate-itemized-individual-receipts-set.v1"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "calculation": {"const": "fec/candidate-itemized-individual-receipts"},
    "calculation_version": {"const": "1.0.0"},
    "decision_schema_version": {"const": "legal-tender.fec.itemized-individual-receipt-decision.v1"},
    "result_schema_version": {"const": "legal-tender.fec.candidate-itemized-individual-receipts.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "input_fact_sets": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/factSet"}
    },
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "published_at": {"type": "string", "format": "date-time"},
    "counts": {"$ref": "#/$defs/counts"},
    "decisions": {"$ref": "#/$defs/artifact"},
    "results": {"$ref": "#/$defs/artifact"},
    "checks": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "factSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "dataset", "fact_type", "fact_set_id", "manifest_sha256"],
      "properties": {
        "role": {"enum": ["schedule_a_receipts", "candidate_committee_linkage", "all_candidates_summary", "current_campaigns_summary"]},
        "dataset": {"enum": ["schedule-a", "candidate-committee-linkage", "all-candidates-summary", "current-campaigns-summary"]},
        "fact_type": {"enum": ["fec.schedule_a_receipt.v1", "fec.candidate_committee_linkage.v1", "fec.candidate_summary_all.v1", "fec.campaign_summary.v1"]},
        "fact_set_id": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_facts", "receipt_decisions", "linkage_facts", "summary_facts", "candidates",
        "complete", "partial", "not_comparable", "reconciliations",
        "date_bounded_reconciliations", "not_comparable_reconciliations"
      ],
      "properties": {
        "receipt_facts": {"type": "integer", "minimum": 0},
        "receipt_decisions": {"type": "integer", "minimum": 0},
        "linkage_facts": {"type": "integer", "minimum": 0},
        "summary_facts": {"type": "integer", "minimum": 0},
        "candidates": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "not_comparable": {"type": "integer", "minimum": 0},
        "reconciliations": {"type": "integer", "minimum": 0},
        "date_bounded_reconciliations": {"type": "integer", "minimum": 0},
        "not_comparable_reconciliations": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "uncompressed_byte_count", "uncompressed_sha256", "compressed_byte_count", "compressed_sha256", "compression", "storage_key"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_byte_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "compressed_byte_count": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "compression": {"const": "zstd"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
