    {"raw_sequence": 22, "raw_field": "contribution_aggregate", "processed_fields": ["contributor_aggregate_ytd"], "processed_relation_fields": ["contb_aggregate_ytd"], "comparator": "source_decimal", "applicability": "always; accumulator only"},
    {"raw_sequence": 23, "raw_field": "contribution_purpose_description", "processed_fields": ["receipt_type_full"], "processed_relation_fields": ["receipt_desc"], "comparator": "source_text", "applicability": "always; processed receipt_type and descriptions remain separate enrichment fields"},
