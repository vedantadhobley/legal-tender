    {"raw_sequence": 39, "raw_field": "conduit_street_2", "processed_fields": ["conduit_committee_street2"], "processed_relation_fields": ["conduit_cmte_st2"], "comparator": "source_text", "applicability": "always"},
    {"raw_sequence": 40, "raw_field": "conduit_city", "processed_fields": ["conduit_committee_city"], "processed_relation_fields": ["conduit_cmte_city"], "comparator": "source_text", "applicability": "always"},
    {"raw_sequence": 41, "raw_field": "conduit_state", "processed_fields": ["conduit_committee_state"], "processed_relation_fields": ["conduit_cmte_st"], "comparator": "source_text", "applicability": "always"},
