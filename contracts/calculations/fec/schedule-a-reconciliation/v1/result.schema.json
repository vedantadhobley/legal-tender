{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/schedule-a-reconciliation/v1/result.schema.json",
  "title": "Raw and processed FEC Schedule A reconciliation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calculation_contract", "calculation_version", "result_state",
    "field_mapping_sha256", "processed_input", "raw_input",
    "revision_alignment", "direct_source_matches", "effective_rows",
    "processed_only", "unresolved_groups", "summary", "change_set",
    "publication", "issues"
  ],
  "properties": {
    "calculation_contract": {"const": "fec/schedule-a-reconciliation"},
    "calculation_version": {"const": "1.0.0"},
    "result_state": {
      "enum": [
        "complete_snapshot", "provisional_targeted_observation",
        "blocked_incomplete_input", "blocked_identity_conflict",
        "blocked_conservation_failure"
      ]
    },
    "field_mapping_sha256": {"$ref": "#/$defs/sha256"},
    "processed_input": {"$ref": "#/$defs/processedInput"},
    "raw_input": {"$ref": "#/$defs/rawInput"},
    "revision_alignment": {"$ref": "#/$defs/revisionAlignment"},
    "direct_source_matches": {
      "type": "array",
      "items": {"$ref": "#/$defs/directSourceMatch"}
    },
    "effective_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/effectiveRow"}
    },
    "processed_only": {
      "type": "array",
      "items": {"$ref": "#/$defs/processedOccurrence"}
    },
    "unresolved_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolvedGroup"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending_row_keys", "conflict_row_keys", "affected_committee_ids", "target_two_year_periods"],
      "properties": {
        "pending_row_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rowKey"}},
        "conflict_row_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rowKey"}},
        "affected_committee_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{8}$"}},
        "target_two_year_periods": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1976, "multipleOf": 2}}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_only", "eligible_for_user_totals", "reason"],
      "properties": {
        "diagnostic_only": {"type": "boolean"},
        "eligible_for_user_totals": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rowKey": {"type": "string", "pattern": "^fec:efile-report:[1-9][0-9]*:SA:.+$"},
    "processedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "contract_version", "source_class", "coverage_state",
        "evidence_sha256", "empty_observation_sha256", "observation_date",
        "two_year_transaction_period", "result_count",
        "processed_file_numbers", "selected_load_dates", "queried_image_ranges"
      ],
      "properties": {
        "contract": {"enum": ["fec/schedule-a-api", "fec/schedule-a"]},
        "contract_version": {"type": "string", "minLength": 1},
        "source_class": {"enum": ["targeted_api_observation", "processed_dump_snapshot"]},
        "coverage_state": {"enum": ["targeted_image_ranges_only", "complete_two_year_partition"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "empty_observation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "observation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "two_year_transaction_period": {"type": "integer", "minimum": 1976, "multipleOf": 2},
        "result_count": {"type": "integer", "minimum": 0},
        "processed_file_numbers": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "selected_load_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "queried_image_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_number", "beginning_image_number", "ending_image_number", "returned_count"],
            "properties": {
              "file_number": {"type": "integer", "minimum": 1},
              "beginning_image_number": {"type": "string", "minLength": 1},
              "ending_image_number": {"type": "string", "minLength": 1},
              "returned_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "rawInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_projection_sha256", "report_family_id", "committee_id",
        "root_file_number", "effective_file_number", "prior_file_number",
        "effective_row_count"
      ],
      "properties": {
        "effective_projection_sha256": {"$ref": "#/$defs/sha256"},
        "report_family_id": {"type": "string", "pattern": "^fec:efile-report:[1-9][0-9]*$"},
        "committee_id": {"type": "string", "pattern": "^C[0-9]{8}$"},
        "root_file_number": {"type": "integer", "minimum": 1},
        "effective_file_number": {"type": "integer", "minimum": 1},
        "prior_file_number": {"type": ["integer", "null"], "minimum": 1},
        "effective_row_count": {"type": "integer", "minimum": 0}
      }
    },
    "revisionAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "processed_selected_file_number", "raw_effective_file_number", "evidence"],
      "properties": {
        "state": {"enum": ["aligned", "processed_lags_raw", "raw_lags_processed", "indeterminate"]},
        "processed_selected_file_number": {"type": ["integer", "null"], "minimum": 1},
        "raw_effective_file_number": {"type": "integer", "minimum": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rawOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_number", "document_sha256", "physical_record_ordinal", "physical_record_sha256"],
      "properties": {
        "file_number": {"type": "integer", "minimum": 1},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "physical_record_ordinal": {"type": "integer", "minimum": 1},
        "physical_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "processedOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "result_ordinal", "sub_id", "file_number", "image_number", "load_date"],
      "properties": {
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "result_ordinal": {"type": "integer", "minimum": 0},
        "sub_id": {"type": "string", "pattern": "^[0-9]+$"},
        "file_number": {"type": "integer", "minimum": 1},
        "image_number": {"type": "string", "minLength": 1},
        "load_date": {"type": ["string", "null"]}
      }
    },
    "comparisonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparable_field_count", "equal_exact", "equal_absent",
        "equal_representation", "processed_enriched", "processed_omitted",
        "different", "not_applicable", "unmapped"
      ],
      "properties": {
        "comparable_field_count": {"type": "integer", "minimum": 0},
        "equal_exact": {"type": "integer", "minimum": 0},
        "equal_absent": {"type": "integer", "minimum": 0},
        "equal_representation": {"type": "integer", "minimum": 0},
        "processed_enriched": {"type": "integer", "minimum": 0},
        "processed_omitted": {"type": "integer", "minimum": 0},
        "different": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "unmapped": {"type": "integer", "minimum": 0}
      }
    },
    "directSourceMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_transaction_id", "relationship_state", "raw_occurrence",
        "processed_occurrence", "identity_signals", "comparison_counts",
        "processed_enriched_fields", "processed_omitted_fields",
        "different_fields", "unmapped_raw_fields"
      ],
      "properties": {
        "raw_transaction_id": {"type": "string", "minLength": 1},
        "relationship_state": {"enum": ["corroborated", "representation_only_difference", "processed_changed", "conflict", "unresolved"]},
        "raw_occurrence": {"$ref": "#/$defs/rawOccurrence"},
        "processed_occurrence": {"$ref": "#/$defs/processedOccurrence"},
        "identity_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["committee_id", "file_number", "transaction_id", "form_and_line", "back_reference", "date_and_amount"]}
        },
        "comparison_counts": {"$ref": "#/$defs/comparisonCounts"},
        "processed_enriched_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "processed_omitted_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "different_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unmapped_raw_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "effectiveRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_key", "transaction_id", "current_change_state",
        "reconciliation_state", "processed_support_state",
        "processed_sub_ids", "changed_fields", "current_occurrence"
      ],
      "properties": {
        "row_key": {"$ref": "#/$defs/rowKey"},
        "transaction_id": {"type": "string", "minLength": 1},
        "current_change_state": {"enum": ["added", "modified", "carried_forward_identical", "representation_changed"]},
        "reconciliation_state": {"enum": ["corroborated", "representation_only_difference", "raw_only_pending_processing", "processed_changed", "conflict", "unresolved"]},
        "processed_support_state": {"enum": ["same_filing", "prior_filing_identical_content", "prior_filing_different_content", "none"]},
        "processed_sub_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+$"}},
        "changed_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "current_occurrence": {"$ref": "#/$defs/rawOccurrence"}
      }
    },
    "unresolvedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "raw_row_keys", "processed_sub_ids"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "raw_row_keys": {"type": "array", "items": {"$ref": "#/$defs/rowKey"}},
        "processed_sub_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+$"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_source_rows", "processed_rows", "direct_corroborated",
        "direct_representation_only", "direct_processed_changed",
        "direct_conflict", "direct_unresolved", "effective_rows",
        "effective_corroborated", "effective_raw_only_pending_processing",
        "effective_processed_changed", "effective_conflict",
        "effective_unresolved", "processed_only"
      ],
      "properties": {
        "raw_source_rows": {"type": "integer", "minimum": 0},
        "processed_rows": {"type": "integer", "minimum": 0},
        "direct_corroborated": {"type": "integer", "minimum": 0},
        "direct_representation_only": {"type": "integer", "minimum": 0},
        "direct_processed_changed": {"type": "integer", "minimum": 0},
        "direct_conflict": {"type": "integer", "minimum": 0},
        "direct_unresolved": {"type": "integer", "minimum": 0},
        "effective_rows": {"type": "integer", "minimum": 0},
        "effective_corroborated": {"type": "integer", "minimum": 0},
        "effective_raw_only_pending_processing": {"type": "integer", "minimum": 0},
        "effective_processed_changed": {"type": "integer", "minimum": 0},
        "effective_conflict": {"type": "integer", "minimum": 0},
        "effective_unresolved": {"type": "integer", "minimum": 0},
        "processed_only": {"type": "integer", "minimum": 0}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "severity": {"enum": ["observe", "partial", "block"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
