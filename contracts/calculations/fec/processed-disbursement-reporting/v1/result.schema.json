{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/processed-disbursement-reporting/v1/result.schema.json",
  "title": "Processed Schedule B reporting calculation; not money-flow edges",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calculation_set_id",
    "policy_version",
    "policy_sha256",
    "state",
    "cycle",
    "input",
    "line_rules",
    "total",
    "decisions",
    "groups",
    "groups_sha256",
    "membership",
    "graph_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "legal-tender.fec.processed-disbursement-reporting.v1"
    },
    "calculation_set_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "const": "legal-tender.fec.processed-disbursement-reporting-policy.v1"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "complete",
        "complete_with_unresolved"
      ]
    },
    "cycle": {
      "type": "string",
      "pattern": "^[0-9]{3}[02468]$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_set_id",
        "manifest_sha256",
        "source_release_id",
        "source_artifact_sha256",
        "physical_schema_version",
        "facts"
      ],
      "properties": {
        "fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_release_id": {
          "type": "string",
          "pattern": "^fec-[a-f0-9]{64}$"
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "physical_schema_version": {
          "const": "legal-tender.fec.schedule-b-parquet.v1"
        },
        "facts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "line_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "form",
          "line",
          "scope",
          "role"
        ],
        "properties": {
          "form": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "$ref": "#/$defs/measures"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_non_memo_itemized_disbursement",
        "excluded_memo_subtotal",
        "separate_reporting_scope",
        "unresolved_reporting"
      ],
      "properties": {
        "included_non_memo_itemized_disbursement": {
          "$ref": "#/$defs/measures"
        },
        "excluded_memo_subtotal": {
          "$ref": "#/$defs/measures"
        },
        "separate_reporting_scope": {
          "$ref": "#/$defs/measures"
        },
        "unresolved_reporting": {
          "$ref": "#/$defs/measures"
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "measures",
          "first_source_row_ordinal"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "measures": {
            "$ref": "#/$defs/measures"
          },
          "first_source_row_ordinal": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "groups_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "membership": {
      "const": "Evaluate(policy_version, source_fact_set_id, source_row_ordinal); no per-transaction deduplication"
    },
    "graph_eligible": {
      "const": false
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "value"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "present": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "measures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "amount_rows",
        "missing_amount_rows",
        "signed_amount_minor_units",
        "positive_rows",
        "negative_rows",
        "zero_rows"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "amount_rows": {
          "type": "integer",
          "minimum": 0
        },
        "missing_amount_rows": {
          "type": "integer",
          "minimum": 0
        },
        "signed_amount_minor_units": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "positive_rows": {
          "type": "integer",
          "minimum": 0
        },
        "negative_rows": {
          "type": "integer",
          "minimum": 0
        },
        "zero_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sender",
        "form",
        "line",
        "schedule",
        "scope",
        "role",
        "decision",
        "reason",
        "recipient_identity",
        "self_recipient",
        "disbursement_type",
        "beneficiary_present",
        "conduit_present"
      ],
      "properties": {
        "sender": {
          "$ref": "#/$defs/cell"
        },
        "form": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/cell"
        },
        "schedule": {
          "$ref": "#/$defs/cell"
        },
        "scope": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "included_non_memo_itemized_disbursement",
            "excluded_memo_subtotal",
            "separate_reporting_scope",
            "unresolved_reporting"
          ]
        },
        "reason": {
          "enum": [
            "memo_code_x",
            "missing_amount",
            "unreviewed_schedule",
            "unreviewed_form_line",
            "distinct_reporting_scope",
            "invalid_filer_id",
            "reviewed_regular_form_line"
          ]
        },
        "recipient_identity": {
          "enum": [
            "exact_matching_committee_id",
            "conflicting_committee_ids",
            "raw_committee_id_only",
            "clean_committee_id_only",
            "no_valid_committee_id"
          ]
        },
        "self_recipient": {
          "type": "boolean"
        },
        "disbursement_type": {
          "$ref": "#/$defs/cell"
        },
        "beneficiary_present": {
          "type": "boolean"
        },
        "conduit_present": {
          "type": "boolean"
        }
      }
    }
  }
}
