{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/independent-expenditure-candidate-resolution/v1/decision.schema.json",
  "title": "Independent-expenditure candidate-reference decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "calculation_set_id", "fact_id",
    "natural_key", "cycle", "spender_committee_id", "support_oppose",
    "amount_minor_units", "reported_candidate", "state", "method",
    "resolved_candidate_id", "candidate_fact_ids", "evidence_codes"
  ],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.independent-expenditure-candidate-resolution.v1"},
    "decision_id": {"$ref": "#/$defs/digest"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "fact_id": {"$ref": "#/$defs/digest"},
    "natural_key": {"type": "string", "minLength": 1},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "spender_committee_id": {"type": "string", "minLength": 1},
    "support_oppose": {"enum": ["S", "O"]},
    "amount_minor_units": {"$ref": "#/$defs/signed_integer"},
    "reported_candidate": {"$ref": "#/$defs/reported_candidate"},
    "state": {"enum": ["confirmed", "resolved", "unverified", "ambiguous", "unresolved"]},
    "method": {
      "enum": [
        "reported_id_exact_context",
        "unique_exact_name_office_context",
        "multiple_exact_name_office_context",
        "reported_id_context_unverified",
        "reported_id_insufficient_context",
        "no_exact_name_office_context",
        "insufficient_reported_context"
      ]
    },
    "resolved_candidate_id": {"type": ["string", "null"], "minLength": 1},
    "candidate_fact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "evidence_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signed_integer": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "nullable_text": {"type": ["string", "null"]},
    "reported_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "name", "office", "office_state", "office_district"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "name": {"$ref": "#/$defs/nullable_text"},
        "office": {"$ref": "#/$defs/nullable_text"},
        "office_state": {"$ref": "#/$defs/nullable_text"},
        "office_district": {"$ref": "#/$defs/nullable_text"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["confirmed", "resolved", "unverified"]}}, "required": ["state"]},
      "then": {"properties": {"resolved_candidate_id": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"resolved_candidate_id": {"type": "null"}}}
    }
  ]
}
