{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/independent-expenditure-candidate-interpretations/v1/manifest.schema.json",
  "title": "Published independent-expenditure candidate interpretations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "calculation_set_id", "calculation",
    "calculation_version", "publisher_version", "interpretation_schema_version",
    "cycle", "source_release_id", "input_candidate_resolution", "run_id",
    "state", "published_at", "method", "counts", "amounts",
    "interpretations", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.independent-expenditure-candidate-interpretation-set.v1"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "calculation": {"const": "fec/independent-expenditure-candidate-interpretations"},
    "calculation_version": {"const": "1.0.0"},
    "publisher_version": {"const": "legal-tender.fec.independent-expenditure-candidate-interpretation-publisher.v1"},
    "interpretation_schema_version": {"const": "legal-tender.fec.independent-expenditure-candidate-interpretation.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "input_candidate_resolution": {"$ref": "#/$defs/input"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "published_at": {"type": "string", "format": "date-time"},
    "method": {"$ref": "#/$defs/method"},
    "counts": {"$ref": "#/$defs/counts"},
    "amounts": {"$ref": "#/$defs/amounts"},
    "interpretations": {"$ref": "#/$defs/artifact"},
    "checks": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signed_integer": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "calculation", "calculation_version", "calculation_set_id", "manifest_sha256", "method_version", "decision_schema_version", "decisions_sha256"],
      "properties": {
        "role": {"const": "candidate_resolution_evidence"},
        "calculation": {"const": "fec/independent-expenditure-candidate-resolution"},
        "calculation_version": {"const": "1.0.0"},
        "calculation_set_id": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "method_version": {"const": "legal-tender.fec.independent-expenditure-candidate-resolution-method.v2"},
        "decision_schema_version": {"const": "legal-tender.fec.independent-expenditure-candidate-resolution.v1"},
        "decisions_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "principles", "safe_default_endpoint"],
      "properties": {
        "version": {"const": "legal-tender.fec.independent-expenditure-candidate-interpretation-method.v1"},
        "principles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
        "safe_default_endpoint": {"type": "string", "minLength": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_decisions", "confirmed", "inferred", "conflicting", "unverified", "ambiguous", "unresolved", "safe_default_endpoints"],
      "properties": {
        "source_decisions": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "inferred": {"type": "integer", "minimum": 0},
        "conflicting": {"type": "integer", "minimum": 0},
        "unverified": {"type": "integer", "minimum": 0},
        "ambiguous": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "safe_default_endpoints": {"type": "integer", "minimum": 0}
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_minor_units", "confirmed_minor_units", "inferred_minor_units", "conflicting_minor_units", "unverified_minor_units", "ambiguous_minor_units", "unresolved_minor_units", "safe_default_minor_units"],
      "properties": {
        "source_minor_units": {"$ref": "#/$defs/signed_integer"},
        "confirmed_minor_units": {"$ref": "#/$defs/signed_integer"},
        "inferred_minor_units": {"$ref": "#/$defs/signed_integer"},
        "conflicting_minor_units": {"$ref": "#/$defs/signed_integer"},
        "unverified_minor_units": {"$ref": "#/$defs/signed_integer"},
        "ambiguous_minor_units": {"$ref": "#/$defs/signed_integer"},
        "unresolved_minor_units": {"$ref": "#/$defs/signed_integer"},
        "safe_default_minor_units": {"$ref": "#/$defs/signed_integer"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "uncompressed_byte_count", "uncompressed_sha256", "compressed_byte_count", "compressed_sha256", "compression", "storage_key"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_byte_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "compressed_byte_count": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "compression": {"const": "zstd"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
