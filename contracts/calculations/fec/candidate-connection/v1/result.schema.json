{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/candidate-connection/v1/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connection_id",
    "policy",
    "executable_sha256",
    "parent_report_id",
    "parent_document_sha256",
    "parent_evidence_id",
    "candidate_id",
    "cycle",
    "parent_verification",
    "source_verification",
    "report_membership",
    "calculation",
    "inputs",
    "observation",
    "source",
    "parent_name_assertions",
    "terminal_attribution_eligible",
    "allocated_amount_minor_units"
  ],
  "properties": {
    "schema_version": {
      "const": "legal-tender.fec.candidate-connection.v1"
    },
    "connection_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "const": "fec/candidate-connection-source-drilldown@1.0.0"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_report_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[HSP][0-9A-Z]{8}$"
    },
    "cycle": {
      "type": "string",
      "pattern": "^[0-9]{3}[02468]$"
    },
    "parent_verification": {
      "const": "content_identity_checked_not_full_recalculation"
    },
    "source_verification": {
      "const": "published_membership_and_full_source_row_verified"
    },
    "report_membership": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "connection_witness",
          "candidate_boundary_observation"
        ]
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculation_set_id",
        "manifest_sha256"
      ],
      "properties": {
        "calculation_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputs": {
      "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/result.schema.json#/properties/input"
    },
    "observation": {
      "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/observation.schema.json"
    },
    "source": {
      "allOf": [
        {
          "$ref": "https://legal-tender.local/contracts/audits/fec/committee-flow-review/v1/result.schema.json#/properties/source_examples/items"
        },
        {
          "properties": {
            "side": {
              "const": "schedule_a"
            },
            "fields": {
              "minProperties": 99,
              "maxProperties": 99
            }
          }
        }
      ]
    },
    "parent_name_assertions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "allOf": [
          {
            "$ref": "https://legal-tender.local/contracts/calculations/fec/candidate-evidence/v2/result.schema.json#/$defs/name"
          },
          {
            "properties": {
              "entity_kind": {
                "const": "committee"
              }
            }
          }
        ]
      }
    },
    "terminal_attribution_eligible": {
      "const": false
    },
    "allocated_amount_minor_units": {
      "type": "null"
    }
  }
}
