{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/candidate-evidence/v2/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "policy",
    "evidence",
    "candidate_name_source",
    "committee_name_source",
    "names",
    "path_example_policy",
    "path_examples"
  ],
  "properties": {
    "schema_version": {
      "const": "legal-tender.fec.candidate-evidence.v2"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "const": "fec/candidate-evidence-presentation@1.0.0"
    },
    "evidence": {
      "$ref": "https://legal-tender.local/contracts/calculations/fec/candidate-evidence/v1/result.schema.json"
    },
    "candidate_name_source": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    },
    "committee_name_source": {
      "$ref": "#/$defs/source"
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "path_example_policy": {
      "const": "first_committee_id_at_each_of_first_three_hop_distances"
    },
    "path_examples": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "cycle",
        "fact_set_id",
        "manifest_sha256",
        "source_release_id",
        "source_release_manifest_sha256",
        "facts"
      ],
      "properties": {
        "dataset": {
          "enum": [
            "committee-master",
            "candidate-master"
          ]
        },
        "cycle": {
          "type": "string",
          "pattern": "^[0-9]{3}[02468]$"
        },
        "fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_release_id": {
          "type": "string",
          "pattern": "^fec-[a-f0-9]{64}$"
        },
        "source_release_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "facts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_kind",
        "state",
        "assertions"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^(C[0-9]{8}|[HSP][0-9A-Z]{8})$"
        },
        "entity_kind": {
          "enum": [
            "committee",
            "candidate"
          ]
        },
        "state": {
          "enum": [
            "reported_name",
            "source_name_blank",
            "conflicting_reported_names",
            "no_reference_record",
            "name_source_not_requested"
          ]
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_id",
              "occurrence_id",
              "raw_name"
            ],
            "properties": {
              "fact_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "occurrence_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "raw_name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_committee_id",
        "authorized_committee_id",
        "hops",
        "has_missing_reported_dates",
        "has_decreasing_reported_dates",
        "has_same_day_hops",
        "has_nonpositive_amount",
        "allocated_amount_minor_units"
      ],
      "properties": {
        "from_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "authorized_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "hops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/observation.schema.json"
          }
        },
        "has_missing_reported_dates": {
          "type": "boolean"
        },
        "has_decreasing_reported_dates": {
          "type": "boolean"
        },
        "has_same_day_hops": {
          "type": "boolean"
        },
        "has_nonpositive_amount": {
          "type": "boolean"
        },
        "allocated_amount_minor_units": {
          "type": "null"
        }
      }
    }
  }
}
