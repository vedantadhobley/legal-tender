{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/efile-report-family/v1/result.schema.json",
  "title": "FEC electronic-filing report-family calculation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calculation_contract", "calculation_version", "observation_boundary",
    "family_id", "root_file_number", "family_state", "selection_state",
    "effective_file_number", "nodes", "assertions", "checks", "issues"
  ],
  "properties": {
    "calculation_contract": {"const": "fec/efile-report-family"},
    "calculation_version": {"const": "1.0.0"},
    "observation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing_received_through_date", "listing_pass_state", "input_digests"],
      "properties": {
        "listing_received_through_date": {"$ref": "#/$defs/date"},
        "listing_pass_state": {"enum": ["converged", "incomplete"]},
        "input_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "family_id": {"type": "string", "pattern": "^fec:efile-report:[1-9][0-9]*$"},
    "root_file_number": {"type": "integer", "minimum": 1},
    "family_state": {"enum": ["complete", "incomplete", "conflict", "invalid"]},
    "selection_state": {
      "enum": [
        "selected", "blocked_incomplete", "blocked_conflict",
        "blocked_invalid_document", "blocked_unsupported_format"
      ]
    },
    "effective_file_number": {"type": ["integer", "null"], "minimum": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/checkResult"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"selection_state": {"const": "selected"}}},
      "then": {"properties": {"effective_file_number": {"type": "integer"}}},
      "else": {"properties": {"effective_file_number": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "nullableFileNumber": {"type": ["integer", "null"], "minimum": 1},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_number", "role", "listing_fixture_sha256", "document_sha256",
        "listing_committee_id", "cover_committee_id", "base_form_type",
        "listing_form_type", "cover_form_type", "filing_disposition",
        "listing_coverage_start_date", "listing_coverage_end_date",
        "cover_coverage_start_date", "cover_coverage_end_date",
        "listing_amendment_number", "listing_amends_file", "listing_amended_by",
        "listing_most_recent", "listing_most_recent_filing",
        "header_format_version", "header_original_report_id",
        "header_amendment_number", "document_state"
      ],
      "properties": {
        "file_number": {"type": "integer", "minimum": 1},
        "role": {"enum": ["original", "amendment", "termination"]},
        "listing_fixture_sha256": {"$ref": "#/$defs/sha256"},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "listing_committee_id": {"type": "string", "pattern": "^C[0-9]{8}$"},
        "cover_committee_id": {"type": "string", "pattern": "^C[0-9]{8}$"},
        "base_form_type": {"type": "string", "minLength": 1},
        "listing_form_type": {"type": "string", "minLength": 1},
        "cover_form_type": {"type": "string", "minLength": 1},
        "filing_disposition": {"enum": ["new", "amendment", "termination"]},
        "listing_coverage_start_date": {"$ref": "#/$defs/date"},
        "listing_coverage_end_date": {"$ref": "#/$defs/date"},
        "cover_coverage_start_date": {"$ref": "#/$defs/date"},
        "cover_coverage_end_date": {"$ref": "#/$defs/date"},
        "listing_amendment_number": {"type": ["integer", "null"], "minimum": 0},
        "listing_amends_file": {"$ref": "#/$defs/nullableFileNumber"},
        "listing_amended_by": {"$ref": "#/$defs/nullableFileNumber"},
        "listing_most_recent": {"type": "boolean"},
        "listing_most_recent_filing": {"$ref": "#/$defs/nullableFileNumber"},
        "header_format_version": {"type": "string", "minLength": 1},
        "header_original_report_id": {
          "type": ["string", "null"],
          "pattern": "^FEC-[1-9][0-9]*$"
        },
        "header_amendment_number": {"type": ["integer", "null"], "minimum": 0},
        "document_state": {"enum": ["accepted", "invalid", "unsupported"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from_file_number", "to_file_number", "evidence"],
      "properties": {
        "type": {"enum": ["immediate_predecessor", "root_reference", "publisher_current_projection"]},
        "from_file_number": {"type": "integer", "minimum": 1},
        "to_file_number": {"type": "integer", "minimum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "state": {"enum": ["pass", "warn", "fail"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "detail", "file_numbers"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "severity": {"enum": ["observe", "partial", "block"]},
        "detail": {"type": "string", "minLength": 1},
        "file_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
