{
  "version": "legal-tender.fec.receipt-family-comparison.v1",
  "map_version": "legal-tender.fec.receipt-family-map.v1",
  "scope": "bounded_per_report_occurrence_comparison_not_financial_membership",
  "families": {
    "F3": ["party_contributions", "other_committee_contributions", "authorized_transfers", "candidate_made_or_guaranteed_loans", "other_loans"],
    "F3X": ["party_contributions", "other_committee_contributions", "affiliated_or_party_transfers", "loans_received"]
  },
  "binding": "reverify_exact_original_metadata_form_filer_report_period_and_observed_chain_candidate; cover_and_numeric_metadata_must_agree",
  "profile": "sha256_pinned_complete_v2_profile_revalidated_against_exact_summary_release; no_bulk_body_rescan",
  "routing": "exact_filing_form_schedule_type_SA_and_line_num; preserve_every_report_group_once; never_reuse_old_11AI_disposition_as_family_filter",
  "memo": "retain_raw_codes; X_is_separate_memo_evidence; blank_or_source_null_is_nonmemo_occurrence_convention_not_cash_proof; other_codes_block_affected_family",
  "amounts": "exact_signed_occurrence_subtotals; unknown_nonmemo_amount_blocks_difference; no_individual_filter_date_clipping_or_transaction_deduplication",
  "empty_detail": "no_nonmemo_family_detail_blocks_numeric_comparison_even_with_explicit_zero_cover_and_complete_original",
  "difference": "qualified_reported_minus_nonmemo_occurrence_detail_in_exact_cents; differences_are_not_repairs_or_unitemized_amounts",
  "limits": [
    "reported_comparisons_not_cash_or_donor_identity",
    "loan_receipt_not_candidate_principal_origin_or_terminal_source",
    "memo_convention_not_blanket_original_source_correction",
    "no_new_family_window_or_summary_comparisons",
    "no_new_full_population_original_membership_gate",
    "F3X_real_complete_original_gate_still_required",
    "thresholded_cover_only_and_other_schedule_families_remain_outside_this_runtime_subset"
  ],
  "guards": {
    "source_body_rescanned": false,
    "family_window_comparison_ready": false,
    "unique_transaction_membership_proven": false,
    "financial_use_eligible": false,
    "terminal_attribution_eligible": false
  }
}
