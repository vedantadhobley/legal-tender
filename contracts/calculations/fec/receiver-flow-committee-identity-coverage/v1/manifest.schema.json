{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/receiver-flow-committee-identity-coverage/v1/manifest.schema.json",
  "title": "Published receiver-flow committee identity-coverage calculation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "calculation_set_id", "calculation", "calculation_version", "publisher_version", "decision_schema_version", "method_version", "cycle", "source_release_id", "inputs", "run_id", "state", "published_at", "counts", "decisions", "checks"],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.receiver-flow-committee-identity-coverage-set.v1"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "calculation": {"const": "fec/receiver-flow-committee-identity-coverage"},
    "calculation_version": {"const": "1.0.0"},
    "publisher_version": {"const": "legal-tender.fec.receiver-flow-committee-identity-coverage-publisher.v1"},
    "decision_schema_version": {"const": "legal-tender.fec.receiver-flow-committee-identity-coverage.v1"},
    "method_version": {"const": "legal-tender.fec.receiver-flow-committee-identity-coverage-method.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "published_at": {"type": "string", "format": "date-time"},
    "counts": {"$ref": "#/$defs/counts"},
    "decisions": {"$ref": "#/$defs/artifact"},
    "checks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["readiness_bundle", "calculation", "current_committee_master", "same_cycle_comparison_masters", "normalized_history_masters", "raw_history_archives"],
      "properties": {
        "readiness_bundle": {
          "type": "object", "additionalProperties": false,
          "required": ["bundle_id", "manifest_sha256"],
          "properties": {"bundle_id": {"$ref": "#/$defs/digest"}, "manifest_sha256": {"$ref": "#/$defs/digest"}}
        },
        "calculation": {
          "type": "object", "additionalProperties": false,
          "required": ["calculation_set_id", "manifest_sha256", "results_sha256"],
          "properties": {"calculation_set_id": {"$ref": "#/$defs/digest"}, "manifest_sha256": {"$ref": "#/$defs/digest"}, "results_sha256": {"$ref": "#/$defs/digest"}}
        },
        "current_committee_master": {"$ref": "#/$defs/fact_set"},
        "same_cycle_comparison_masters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact_set"}},
        "normalized_history_masters": {"type": "array", "items": {"$ref": "#/$defs/fact_set"}},
        "raw_history_archives": {"type": "array", "items": {"$ref": "#/$defs/raw_history"}}
      }
    },
    "fact_set": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "cycle", "source_release_id", "fact_set_id", "manifest_sha256", "facts_sha256"],
      "properties": {
        "dataset": {"const": "committee-master"},
        "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
        "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
        "fact_set_id": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "facts_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "raw_history": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle", "source_url", "storage_key", "archive_sha256", "archive_bytes", "member", "member_bytes", "committee_records", "clean_records", "issue_records", "issue_counts"],
      "properties": {
        "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
        "source_url": {"type": "string", "format": "uri"},
        "storage_key": {"type": "string", "minLength": 1},
        "archive_sha256": {"$ref": "#/$defs/digest"},
        "archive_bytes": {"type": "integer", "minimum": 1},
        "member": {"type": "string", "minLength": 1},
        "member_bytes": {"type": "integer", "minimum": 1},
        "committee_records": {"type": "integer", "minimum": 0},
        "clean_records": {"type": "integer", "minimum": 0},
        "issue_records": {"type": "integer", "minimum": 0},
        "issue_counts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "rows"],
            "properties": {"code": {"type": "string", "minLength": 1}, "rows": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["referenced_committees", "current_cycle_masters", "identity_coverage_decisions", "historical_registrations", "alternate_release_registrations", "unresolved_reported_ids", "terminal_identity_eligible", "terminal_identity_ineligible", "source_endpoint_decisions", "recipient_endpoint_decisions", "both_endpoint_role_decisions", "historical_registration_assertions", "alternate_registration_assertions"],
      "properties": {
        "referenced_committees": {"type": "integer", "minimum": 1},
        "current_cycle_masters": {"type": "integer", "minimum": 0},
        "identity_coverage_decisions": {"type": "integer", "minimum": 0},
        "historical_registrations": {"type": "integer", "minimum": 0},
        "alternate_release_registrations": {"type": "integer", "minimum": 0},
        "unresolved_reported_ids": {"type": "integer", "minimum": 0},
        "terminal_identity_eligible": {"type": "integer", "minimum": 0},
        "terminal_identity_ineligible": {"type": "integer", "minimum": 0},
        "source_endpoint_decisions": {"type": "integer", "minimum": 0},
        "recipient_endpoint_decisions": {"type": "integer", "minimum": 0},
        "both_endpoint_role_decisions": {"type": "integer", "minimum": 0},
        "historical_registration_assertions": {"type": "integer", "minimum": 0},
        "alternate_registration_assertions": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["record_count", "uncompressed_byte_count", "uncompressed_sha256", "compressed_byte_count", "compressed_sha256", "compression", "storage_key"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_byte_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "compressed_byte_count": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "compression": {"const": "zstd"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "passed": {"const": true}, "severity": {"const": "block"}, "detail": {"type": "string", "minLength": 1}}
    }
  }
}
