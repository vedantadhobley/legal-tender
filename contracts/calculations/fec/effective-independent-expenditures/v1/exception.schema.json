{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/effective-independent-expenditures/v1/exception.schema.json",
  "title": "Effective independent-expenditure sparse exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "exception_id", "calculation_set_id", "fact_id",
    "natural_key", "state", "amount_minor_units", "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.effective-independent-expenditure-exception.v1"},
    "exception_id": {"$ref": "#/$defs/digest"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "fact_id": {"$ref": "#/$defs/digest"},
    "natural_key": {"type": "string", "pattern": "^fec:schedule-e:[0-9]{4}:[0-9]+$"},
    "state": {"enum": ["unresolved_amount", "included_unattributed"]},
    "amount_minor_units": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)$"},
    "reason_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["amount_source_null", "amount_invalid", "missing_spender", "missing_candidate", "invalid_support_oppose"]}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "unresolved_amount"}}},
      "then": {
        "properties": {
          "amount_minor_units": {"type": "null"},
          "reason_codes": {
            "contains": {"enum": ["amount_source_null", "amount_invalid"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "included_unattributed"}}},
      "then": {
        "properties": {
          "amount_minor_units": {"type": "string"},
          "reason_codes": {
            "contains": {"enum": ["missing_spender", "missing_candidate", "invalid_support_oppose"]}
          }
        }
      }
    }
  ]
}
