{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/effective-independent-expenditures/v1/result.schema.json",
  "title": "Effective independent-expenditure spender-candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "calculation_set_id", "cycle",
    "spender_committee_id", "candidate_id", "support_oppose",
    "signed_amount_minor_units", "expenditure_count", "positive_count",
    "negative_count", "zero_count", "missing_expenditure_type_count"
  ],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.effective-independent-expenditure-spender-candidate.v1"},
    "result_id": {"$ref": "#/$defs/digest"},
    "calculation_set_id": {"$ref": "#/$defs/digest"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "spender_committee_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "support_oppose": {"enum": ["S", "O"]},
    "signed_amount_minor_units": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "expenditure_count": {"type": "integer", "minimum": 1},
    "positive_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "zero_count": {"type": "integer", "minimum": 0},
    "missing_expenditure_type_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "properties": {
        "expenditure_count": {
          "description": "Must equal positive_count + negative_count + zero_count; enforced by the Go publisher."
        }
      }
    }
  ]
}
