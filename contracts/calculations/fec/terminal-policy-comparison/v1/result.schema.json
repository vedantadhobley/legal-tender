{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/calculations/fec/terminal-policy-comparison/v1/result.schema.json",
  "title": "Terminal-policy comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_id", "policy", "executable_sha256",
    "candidate_id", "cycle", "input", "scope", "terminal_definitions",
    "allocation_methods", "scenarios", "terminal_policy",
    "allocation_policy", "terminal_attribution_eligible"
  ],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.terminal-policy-comparison.v1"},
    "comparison_id": {"$ref": "#/$defs/digest"},
    "policy": {"const": "fec/terminal-policy-comparison@1.0.0"},
    "executable_sha256": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "pattern": "^[HSP][0-9A-Z]{8}$"},
    "cycle": {"type": "string", "pattern": "^[0-9]{3}[02468]$"},
    "input": {"$ref": "#/$defs/input"},
    "scope": {"$ref": "#/$defs/scope"},
    "terminal_definitions": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/definition"}
    },
    "allocation_methods": {
      "type": "array", "minItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/method"}
    },
    "scenarios": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "terminal_policy": {"type": "null"},
    "allocation_policy": {"type": "null"},
    "terminal_attribution_eligible": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signed_integer": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_dossier_id", "candidate_dossier_sha256", "receipt_fact_set_id", "receipt_manifest_sha256", "receipt_fec_source_release_id"],
      "properties": {
        "candidate_dossier_id": {"$ref": "#/$defs/digest"},
        "candidate_dossier_sha256": {"$ref": "#/$defs/digest"},
        "receipt_fact_set_id": {"$ref": "#/$defs/digest"},
        "receipt_manifest_sha256": {"$ref": "#/$defs/digest"},
        "receipt_fec_source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"}
      }
    },
    "measures": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "known_amount_rows", "unknown_amount_rows", "positive_rows", "negative_rows", "zero_rows", "signed_minor_units", "positive_minor_units", "negative_minor_units"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "known_amount_rows": {"type": "integer", "minimum": 0},
        "unknown_amount_rows": {"type": "integer", "minimum": 0},
        "positive_rows": {"type": "integer", "minimum": 0},
        "negative_rows": {"type": "integer", "minimum": 0},
        "zero_rows": {"type": "integer", "minimum": 0},
        "signed_minor_units": {"$ref": "#/$defs/signed_integer"},
        "positive_minor_units": {"$ref": "#/$defs/signed_integer"},
        "negative_minor_units": {"$ref": "#/$defs/signed_integer"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "included_nonmemo_population", "excluded_memo_population", "limitations", "complete_candidate_funding_basis", "includes_independent_expenditures"],
      "properties": {
        "state": {"const": "candidate_linked_known_and_unknown_nonmemo_schedule_a_appearances"},
        "included_nonmemo_population": {"$ref": "#/$defs/measures"},
        "excluded_memo_population": {"$ref": "#/$defs/measures"},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "complete_candidate_funding_basis": {"const": false},
        "includes_independent_expenditures": {"const": false}
      }
    },
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_id", "boundary", "status", "meaning"],
      "properties": {
        "definition_id": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
        "boundary": {"type": "string", "minLength": 1},
        "status": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "meaning": {"type": "string", "minLength": 1},
        "blocker": {"type": "string", "minLength": 1}
      }
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["method_id", "status", "rule", "conservation"],
      "properties": {
        "method_id": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
        "status": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "rule": {"type": "string", "minLength": 1},
        "conservation": {"enum": ["exact", "not_executable", "fails_by_design"]},
        "blocker": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "status", "terminal_definition_ids", "allocation_method_id", "direct", "explicitly_earmarked", "proportional", "unresolved", "exactly_conserved", "selected", "notes"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
        "status": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "terminal_definition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"}},
        "allocation_method_id": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
        "direct": {"$ref": "#/$defs/measures"},
        "explicitly_earmarked": {"$ref": "#/$defs/measures"},
        "proportional": {"$ref": "#/$defs/measures"},
        "unresolved": {"$ref": "#/$defs/measures"},
        "exactly_conserved": {"const": true},
        "selected": {"const": false},
        "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
