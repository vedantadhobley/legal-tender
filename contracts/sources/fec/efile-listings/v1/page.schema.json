{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/fec/efile-listings/v1/page.schema.json",
  "title": "OpenFEC electronic-filing listing page",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "pagination", "results"],
  "properties": {
    "api_version": {"type": "string", "minLength": 1},
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "is_count_exact", "page", "pages", "per_page"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "is_count_exact": {"type": "boolean"},
        "page": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 0},
        "per_page": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "results": {
      "type": "array",
      "items": {"$ref": "record.schema.json"}
    }
  }
}
