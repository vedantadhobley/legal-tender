{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/fec/efile-schedule-a/v1/record.schema.json",
  "title": "Canonical occurrence of an as-filed FEC Schedule A row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_number", "document_sha256", "header_format_version",
    "physical_record_ordinal", "byte_start", "byte_end_exclusive",
    "record_terminator_hex", "physical_record_sha256",
    "physical_field_count", "canonical_field_count", "extra_fields", "fields"
  ],
  "properties": {
    "file_number": {"type": "integer", "minimum": 1},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "header_format_version": {"enum": ["8.3", "8.4", "8.5"]},
    "physical_record_ordinal": {"type": "integer", "minimum": 1},
    "byte_start": {"type": "integer", "minimum": 0},
    "byte_end_exclusive": {"type": "integer", "minimum": 1},
    "record_terminator_hex": {"enum": ["0d0a", "0a"]},
    "physical_record_sha256": {"$ref": "#/$defs/sha256"},
    "physical_field_count": {"type": "integer", "minimum": 1},
    "canonical_field_count": {"const": 45},
    "extra_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_type", "filer_committee_id_number", "transaction_id",
        "back_reference_transaction_id_number", "back_reference_schedule_name",
        "entity_type", "contributor_organization_name", "contributor_last_name",
        "contributor_first_name", "contributor_middle_name", "contributor_prefix",
        "contributor_suffix", "contributor_street_1", "contributor_street_2",
        "contributor_city", "contributor_state", "contributor_zip", "election_code",
        "election_other_description", "contribution_date", "contribution_amount",
        "contribution_aggregate", "contribution_purpose_description",
        "contributor_employer", "contributor_occupation", "donor_committee_fec_id",
        "donor_committee_name", "donor_candidate_fec_id",
        "donor_candidate_last_name", "donor_candidate_first_name",
        "donor_candidate_middle_name", "donor_candidate_prefix",
        "donor_candidate_suffix", "donor_candidate_office",
        "donor_candidate_state", "donor_candidate_district", "conduit_name",
        "conduit_street_1", "conduit_street_2", "conduit_city", "conduit_state",
        "conduit_zip", "memo_code", "memo_text_description", "account_system_code"
      ],
      "properties": {
        "form_type": {"$ref": "#/$defs/sourceField"},
        "filer_committee_id_number": {"$ref": "#/$defs/sourceField"},
        "transaction_id": {"$ref": "#/$defs/sourceField"},
        "back_reference_transaction_id_number": {"$ref": "#/$defs/sourceField"},
        "back_reference_schedule_name": {"$ref": "#/$defs/sourceField"},
        "entity_type": {"$ref": "#/$defs/sourceField"},
        "contributor_organization_name": {"$ref": "#/$defs/sourceField"},
        "contributor_last_name": {"$ref": "#/$defs/sourceField"},
        "contributor_first_name": {"$ref": "#/$defs/sourceField"},
        "contributor_middle_name": {"$ref": "#/$defs/sourceField"},
        "contributor_prefix": {"$ref": "#/$defs/sourceField"},
        "contributor_suffix": {"$ref": "#/$defs/sourceField"},
        "contributor_street_1": {"$ref": "#/$defs/sourceField"},
        "contributor_street_2": {"$ref": "#/$defs/sourceField"},
        "contributor_city": {"$ref": "#/$defs/sourceField"},
        "contributor_state": {"$ref": "#/$defs/sourceField"},
        "contributor_zip": {"$ref": "#/$defs/sourceField"},
        "election_code": {"$ref": "#/$defs/sourceField"},
        "election_other_description": {"$ref": "#/$defs/sourceField"},
        "contribution_date": {"$ref": "#/$defs/sourceField"},
        "contribution_amount": {"$ref": "#/$defs/sourceField"},
        "contribution_aggregate": {"$ref": "#/$defs/sourceField"},
        "contribution_purpose_description": {"$ref": "#/$defs/sourceField"},
        "contributor_employer": {"$ref": "#/$defs/sourceField"},
        "contributor_occupation": {"$ref": "#/$defs/sourceField"},
        "donor_committee_fec_id": {"$ref": "#/$defs/sourceField"},
        "donor_committee_name": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_fec_id": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_last_name": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_first_name": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_middle_name": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_prefix": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_suffix": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_office": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_state": {"$ref": "#/$defs/sourceField"},
        "donor_candidate_district": {"$ref": "#/$defs/sourceField"},
        "conduit_name": {"$ref": "#/$defs/sourceField"},
        "conduit_street_1": {"$ref": "#/$defs/sourceField"},
        "conduit_street_2": {"$ref": "#/$defs/sourceField"},
        "conduit_city": {"$ref": "#/$defs/sourceField"},
        "conduit_state": {"$ref": "#/$defs/sourceField"},
        "conduit_zip": {"$ref": "#/$defs/sourceField"},
        "memo_code": {"$ref": "#/$defs/sourceField"},
        "memo_text_description": {"$ref": "#/$defs/sourceField"},
        "account_system_code": {"$ref": "#/$defs/sourceField"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceField": {
      "description": "Exact decoded field text; empty string is an explicit physical field and null means an omitted trailing logical field.",
      "type": ["string", "null"]
    }
  }
}
