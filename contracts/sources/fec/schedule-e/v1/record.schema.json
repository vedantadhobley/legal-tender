{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/fec/schedule-e/v1/record.schema.json",
  "title": "FEC processed Schedule E relation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cmte_id", "cmte_nm", "pye_nm", "payee_l_nm", "payee_f_nm",
    "payee_m_nm", "payee_prefix", "payee_suffix", "pye_st1", "pye_st2",
    "pye_city", "pye_st", "pye_zip", "entity_tp", "entity_tp_desc",
    "exp_desc", "catg_cd", "catg_cd_desc", "s_o_cand_id", "s_o_cand_nm",
    "s_o_cand_nm_first", "s_o_cand_nm_last", "s_o_cand_m_nm",
    "s_o_cand_prefix", "s_o_cand_suffix", "s_o_cand_office",
    "s_o_cand_office_desc", "s_o_cand_office_st", "s_o_cand_office_st_desc",
    "s_o_cand_office_district", "s_o_ind", "s_o_ind_desc", "election_tp",
    "fec_election_tp_desc", "cal_ytd_ofc_sought", "dissem_dt", "exp_amt",
    "exp_dt", "exp_tp", "exp_tp_desc", "memo_cd", "memo_cd_desc",
    "memo_text", "conduit_cmte_id", "conduit_cmte_nm", "conduit_cmte_st1",
    "conduit_cmte_st2", "conduit_cmte_city", "conduit_cmte_st",
    "conduit_cmte_zip", "indt_sign_nm", "indt_sign_dt", "notary_sign_nm",
    "notary_sign_dt", "notary_commission_exprtn_dt", "filer_l_nm",
    "filer_f_nm", "filer_m_nm", "filer_prefix", "filer_suffix", "action_cd",
    "action_cd_desc", "tran_id", "back_ref_tran_id", "back_ref_sched_nm",
    "schedule_type", "schedule_type_desc", "line_num", "image_num", "file_num",
    "link_id", "orig_sub_id", "sub_id", "filing_form", "rpt_tp", "rpt_yr",
    "election_cycle", "pdf_url", "payee_name_text", "pg_date"
  ],
  "$defs": {
    "nullable_text": {"type": ["string", "null"]},
    "money": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"},
    "integer4": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,3})$"},
    "integer7": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,6})$"},
    "integer19": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,18})$"},
    "timestamp_without_timezone": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    }
  },
  "properties": {
    "cmte_id": {"$ref": "#/$defs/nullable_text"},
    "cmte_nm": {"$ref": "#/$defs/nullable_text"},
    "pye_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_l_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_f_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_m_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_prefix": {"$ref": "#/$defs/nullable_text"},
    "payee_suffix": {"$ref": "#/$defs/nullable_text"},
    "pye_st1": {"$ref": "#/$defs/nullable_text"},
    "pye_st2": {"$ref": "#/$defs/nullable_text"},
    "pye_city": {"$ref": "#/$defs/nullable_text"},
    "pye_st": {"$ref": "#/$defs/nullable_text"},
    "pye_zip": {"$ref": "#/$defs/nullable_text"},
    "entity_tp": {"$ref": "#/$defs/nullable_text"},
    "entity_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "exp_desc": {"$ref": "#/$defs/nullable_text"},
    "catg_cd": {"$ref": "#/$defs/nullable_text"},
    "catg_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_id": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_nm": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_nm_first": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_nm_last": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_m_nm": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_prefix": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_suffix": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_office": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_office_desc": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_office_st": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_office_st_desc": {"$ref": "#/$defs/nullable_text"},
    "s_o_cand_office_district": {"$ref": "#/$defs/nullable_text"},
    "s_o_ind": {"$ref": "#/$defs/nullable_text"},
    "s_o_ind_desc": {"$ref": "#/$defs/nullable_text"},
    "election_tp": {"$ref": "#/$defs/nullable_text"},
    "fec_election_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "cal_ytd_ofc_sought": {"$ref": "#/$defs/money"},
    "dissem_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "exp_amt": {"$ref": "#/$defs/money"},
    "exp_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "exp_tp": {"$ref": "#/$defs/nullable_text"},
    "exp_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "memo_cd": {"$ref": "#/$defs/nullable_text"},
    "memo_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "memo_text": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_id": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_nm": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st1": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st2": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_city": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_zip": {"$ref": "#/$defs/nullable_text"},
    "indt_sign_nm": {"$ref": "#/$defs/nullable_text"},
    "indt_sign_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "notary_sign_nm": {"$ref": "#/$defs/nullable_text"},
    "notary_sign_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "notary_commission_exprtn_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "filer_l_nm": {"$ref": "#/$defs/nullable_text"},
    "filer_f_nm": {"$ref": "#/$defs/nullable_text"},
    "filer_m_nm": {"$ref": "#/$defs/nullable_text"},
    "filer_prefix": {"$ref": "#/$defs/nullable_text"},
    "filer_suffix": {"$ref": "#/$defs/nullable_text"},
    "action_cd": {"$ref": "#/$defs/nullable_text"},
    "action_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "tran_id": {"$ref": "#/$defs/nullable_text"},
    "back_ref_tran_id": {"$ref": "#/$defs/nullable_text"},
    "back_ref_sched_nm": {"$ref": "#/$defs/nullable_text"},
    "schedule_type": {"$ref": "#/$defs/nullable_text"},
    "schedule_type_desc": {"$ref": "#/$defs/nullable_text"},
    "line_num": {"$ref": "#/$defs/nullable_text"},
    "image_num": {"$ref": "#/$defs/nullable_text"},
    "file_num": {"$ref": "#/$defs/integer7"},
    "link_id": {"$ref": "#/$defs/integer19"},
    "orig_sub_id": {"$ref": "#/$defs/integer19"},
    "sub_id": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "filing_form": {"type": "string", "minLength": 1},
    "rpt_tp": {"$ref": "#/$defs/nullable_text"},
    "rpt_yr": {"$ref": "#/$defs/integer4"},
    "election_cycle": {"$ref": "#/$defs/integer4"},
    "pdf_url": {"type": ["string", "null"], "format": "uri"},
    "payee_name_text": {"$ref": "#/$defs/nullable_text"},
    "pg_date": {"$ref": "#/$defs/timestamp_without_timezone"}
  }
}
