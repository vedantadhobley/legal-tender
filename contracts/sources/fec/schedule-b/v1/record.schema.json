{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/fec/schedule-b/v1/record.schema.json",
  "title": "FEC processed Schedule B relation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cmte_id", "recipient_cmte_id", "recipient_nm", "payee_l_nm",
    "payee_f_nm", "payee_m_nm", "payee_prefix", "payee_suffix",
    "payee_employer", "payee_occupation", "recipient_st1", "recipient_st2",
    "recipient_city", "recipient_st", "recipient_zip", "disb_desc", "catg_cd",
    "catg_cd_desc", "entity_tp", "entity_tp_desc", "election_tp",
    "fec_election_tp_desc", "fec_election_tp_year", "election_tp_desc",
    "cand_id", "cand_nm", "cand_nm_first", "cand_nm_last", "cand_m_nm",
    "cand_prefix", "cand_suffix", "cand_office", "cand_office_desc",
    "cand_office_st", "cand_office_st_desc", "cand_office_district", "disb_dt",
    "disb_amt", "memo_cd", "memo_cd_desc", "memo_text", "disb_tp",
    "disb_tp_desc", "conduit_cmte_nm", "conduit_cmte_st1", "conduit_cmte_st2",
    "conduit_cmte_city", "conduit_cmte_st", "conduit_cmte_zip",
    "national_cmte_nonfed_acct", "ref_disp_excess_flg", "comm_dt",
    "benef_cmte_nm", "semi_an_bundled_refund", "action_cd", "action_cd_desc",
    "tran_id", "back_ref_tran_id", "back_ref_sched_id", "schedule_type",
    "schedule_type_desc", "line_num", "image_num", "file_num", "link_id",
    "orig_sub_id", "sub_id", "filing_form", "rpt_tp", "rpt_yr",
    "two_year_transaction_period", "pdf_url", "recipient_name_text",
    "disbursement_description_text", "disbursement_purpose_category",
    "clean_recipient_cmte_id", "pg_date", "line_number_label", "cmte_tp",
    "org_tp", "cmte_dsgn"
  ],
  "$defs": {
    "nullable_text": {"type": ["string", "null"]},
    "money": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"},
    "integer4": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,3})$"},
    "integer7": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,6})$"},
    "integer19": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,18})$"},
    "timestamp_without_timezone": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    }
  },
  "properties": {
    "cmte_id": {"$ref": "#/$defs/nullable_text"},
    "recipient_cmte_id": {"$ref": "#/$defs/nullable_text"},
    "recipient_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_l_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_f_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_m_nm": {"$ref": "#/$defs/nullable_text"},
    "payee_prefix": {"$ref": "#/$defs/nullable_text"},
    "payee_suffix": {"$ref": "#/$defs/nullable_text"},
    "payee_employer": {"$ref": "#/$defs/nullable_text"},
    "payee_occupation": {"$ref": "#/$defs/nullable_text"},
    "recipient_st1": {"$ref": "#/$defs/nullable_text"},
    "recipient_st2": {"$ref": "#/$defs/nullable_text"},
    "recipient_city": {"$ref": "#/$defs/nullable_text"},
    "recipient_st": {"$ref": "#/$defs/nullable_text"},
    "recipient_zip": {"$ref": "#/$defs/nullable_text"},
    "disb_desc": {"$ref": "#/$defs/nullable_text"},
    "catg_cd": {"$ref": "#/$defs/nullable_text"},
    "catg_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "entity_tp": {"$ref": "#/$defs/nullable_text"},
    "entity_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "election_tp": {"$ref": "#/$defs/nullable_text"},
    "fec_election_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "fec_election_tp_year": {"$ref": "#/$defs/nullable_text"},
    "election_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "cand_id": {"$ref": "#/$defs/nullable_text"},
    "cand_nm": {"$ref": "#/$defs/nullable_text"},
    "cand_nm_first": {"$ref": "#/$defs/nullable_text"},
    "cand_nm_last": {"$ref": "#/$defs/nullable_text"},
    "cand_m_nm": {"$ref": "#/$defs/nullable_text"},
    "cand_prefix": {"$ref": "#/$defs/nullable_text"},
    "cand_suffix": {"$ref": "#/$defs/nullable_text"},
    "cand_office": {"$ref": "#/$defs/nullable_text"},
    "cand_office_desc": {"$ref": "#/$defs/nullable_text"},
    "cand_office_st": {"$ref": "#/$defs/nullable_text"},
    "cand_office_st_desc": {"$ref": "#/$defs/nullable_text"},
    "cand_office_district": {"$ref": "#/$defs/nullable_text"},
    "disb_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "disb_amt": {"$ref": "#/$defs/money"},
    "memo_cd": {"$ref": "#/$defs/nullable_text"},
    "memo_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "memo_text": {"$ref": "#/$defs/nullable_text"},
    "disb_tp": {"$ref": "#/$defs/nullable_text"},
    "disb_tp_desc": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_nm": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st1": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st2": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_city": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_st": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_zip": {"$ref": "#/$defs/nullable_text"},
    "national_cmte_nonfed_acct": {"$ref": "#/$defs/nullable_text"},
    "ref_disp_excess_flg": {"$ref": "#/$defs/nullable_text"},
    "comm_dt": {"$ref": "#/$defs/timestamp_without_timezone"},
    "benef_cmte_nm": {"$ref": "#/$defs/nullable_text"},
    "semi_an_bundled_refund": {"$ref": "#/$defs/money"},
    "action_cd": {"$ref": "#/$defs/nullable_text"},
    "action_cd_desc": {"$ref": "#/$defs/nullable_text"},
    "tran_id": {"$ref": "#/$defs/nullable_text"},
    "back_ref_tran_id": {"$ref": "#/$defs/nullable_text"},
    "back_ref_sched_id": {"$ref": "#/$defs/nullable_text"},
    "schedule_type": {"$ref": "#/$defs/nullable_text"},
    "schedule_type_desc": {"$ref": "#/$defs/nullable_text"},
    "line_num": {"$ref": "#/$defs/nullable_text"},
    "image_num": {"$ref": "#/$defs/nullable_text"},
    "file_num": {"$ref": "#/$defs/integer7"},
    "link_id": {"$ref": "#/$defs/integer19"},
    "orig_sub_id": {"$ref": "#/$defs/integer19"},
    "sub_id": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "filing_form": {"type": "string", "minLength": 1},
    "rpt_tp": {"$ref": "#/$defs/nullable_text"},
    "rpt_yr": {"$ref": "#/$defs/integer4"},
    "two_year_transaction_period": {"$ref": "#/$defs/integer4"},
    "pdf_url": {"type": ["string", "null"], "format": "uri"},
    "recipient_name_text": {"$ref": "#/$defs/nullable_text"},
    "disbursement_description_text": {"$ref": "#/$defs/nullable_text"},
    "disbursement_purpose_category": {"$ref": "#/$defs/nullable_text"},
    "clean_recipient_cmte_id": {"$ref": "#/$defs/nullable_text"},
    "pg_date": {"$ref": "#/$defs/timestamp_without_timezone"},
    "line_number_label": {"$ref": "#/$defs/nullable_text"},
    "cmte_tp": {"$ref": "#/$defs/nullable_text"},
    "org_tp": {"$ref": "#/$defs/nullable_text"},
    "cmte_dsgn": {"$ref": "#/$defs/nullable_text"}
  }
}
