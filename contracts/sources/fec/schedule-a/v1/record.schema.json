    "conduit_cmte_st": {"$ref": "#/$defs/nullable_text"},
    "conduit_cmte_zip": {"$ref": "#/$defs/nullable_text"},
    "donor_cmte_nm": {"$ref": "#/$defs/nullable_text"},
    "national_cmte_nonfed_acct": {"$ref": "#/$defs/nullable_text"},
    "increased_limit": {"$ref": "#/$defs/nullable_text"},
    "action_cd": {"$ref": "#/$defs/nullable_text"},
