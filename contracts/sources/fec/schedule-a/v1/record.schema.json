    "contributor_occupation_text", "is_individual", "clean_contbr_id",
    "pg_date", "line_number_label", "cmte_tp", "org_tp", "cmte_dsgn"
  ],
  "$defs": {
    "nullable_text": {"type": ["string", "null"]},
    "money": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "integer": {"type": ["string", "null"], "pattern": "^-?[0-9]+$"},
    "timestamp_without_timezone": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"}
  },
