{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/fec/schedule-a-api/v1/page.schema.json",
  "title": "OpenFEC processed Schedule A keyset page",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "pagination", "results"],
  "properties": {
    "api_version": {"type": "string", "minLength": 1},
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "is_count_exact", "last_indexes", "pages", "per_page"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "is_count_exact": {"type": "boolean"},
        "last_indexes": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["last_contribution_receipt_date", "last_index"],
              "properties": {
                "last_contribution_receipt_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                "last_index": {"type": "string", "pattern": "^[0-9]+$"}
              }
            },
            {"type": "null"}
          ]
        },
        "pages": {"type": "integer", "minimum": 0},
        "per_page": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "results": {
      "type": "array",
      "items": {"$ref": "record.schema.json"}
    }
  }
}
