{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/sec/company-tickers/v1/record.schema.json",
  "title": "SEC company ticker directory snapshot",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 100000,
  "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["cik_str", "ticker", "title"],
    "properties": {
      "cik_str": {"type": "integer", "minimum": 1, "maximum": 9999999999},
      "ticker": {"type": "string", "pattern": "\\S"},
      "title": {"type": "string", "pattern": "\\S"}
    }
  }
}
