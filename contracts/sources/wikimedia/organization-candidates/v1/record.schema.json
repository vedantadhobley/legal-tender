{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Bounded Wikimedia organization candidate responses",
  "description":"Successful source shapes. Failures remain captured raw and block proposal use. Go additionally validates requested IDs, dates, language codes, budgets and complete page metadata. Opaque objects below are retained, not interpreted as relationships.",
  "oneOf":[{"$ref":"#/$defs/search"},{"$ref":"#/$defs/entities"}],
  "$defs":{
    "revision":{"type":"object","additionalProperties":false,"required":["revid","parentid","timestamp"],"properties":{"revid":{"type":"integer","minimum":1},"parentid":{"type":"integer","minimum":0},"timestamp":{"type":"string","format":"date-time"}}},
    "page":{"type":"object","additionalProperties":false,"required":["pageid","ns","title","index","revisions"],"properties":{
      "pageid":{"type":"integer","minimum":1},"ns":{"const":0},"title":{"type":"string","minLength":1},"index":{"type":"integer","minimum":1,"maximum":5},
      "pageprops":{"type":"object","additionalProperties":false,"properties":{"wikibase_item":{"type":"string","pattern":"^Q[1-9][0-9]*$"},"disambiguation":{"type":"string"}}},
      "revisions":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/revision"}}
    }},
    "search":{"type":"object","additionalProperties":false,"required":["batchcomplete"],"properties":{
      "batchcomplete":{"const":true},"continue":{"type":"object"},"limits":{"type":"object"},
      "query":{"type":"object","additionalProperties":false,"required":["pages"],"properties":{"pages":{"type":"array","maxItems":5,"items":{"$ref":"#/$defs/page"}}}}
    }},
    "term":{"type":"object","additionalProperties":false,"required":["language","value"],"properties":{"language":{"const":"en"},"value":{"type":"string","minLength":1}}},
    "terms":{"type":"object","additionalProperties":false,"properties":{"en":{"$ref":"#/$defs/term"}}},
    "entity":{"type":"object","additionalProperties":false,"required":["id"],"properties":{
      "id":{"type":"string","pattern":"^Q[1-9][0-9]*$"},"missing":{"enum":[true,""]},
      "type":{"const":"item"},"pageid":{"type":"integer","minimum":1},"ns":{"const":0},"title":{"type":"string","pattern":"^Q[1-9][0-9]*$"},"lastrevid":{"type":"integer","minimum":1},"modified":{"type":"string","format":"date-time"},
      "labels":{"$ref":"#/$defs/terms"},"descriptions":{"$ref":"#/$defs/terms"},
      "aliases":{"type":"object","additionalProperties":false,"properties":{"en":{"type":"array","items":{"$ref":"#/$defs/term"}}}},
      "claims":{"type":"object","propertyNames":{"pattern":"^P[1-9][0-9]*$"},"additionalProperties":{"type":"array","items":{"type":"object"}}},
      "sitelinks":{"type":"object","additionalProperties":{"type":"object"}}
    },"if":{"required":["missing"]},"then":{"not":{"anyOf":[{"required":["type"]},{"required":["lastrevid"]},{"required":["labels"]},{"required":["claims"]}]}},"else":{"required":["type","pageid","ns","title","lastrevid","modified"]}},
    "entities":{"type":"object","additionalProperties":false,"required":["entities","success"],"properties":{"success":{"const":1},"entities":{"type":"object","minProperties":1,"maxProperties":5,"propertyNames":{"pattern":"^Q[1-9][0-9]*$"},"additionalProperties":{"$ref":"#/$defs/entity"}}}}
  }
}
