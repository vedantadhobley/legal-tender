{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/sources/lda/rules/v1/schema.json",
  "title": "LDA monetary source rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "rule_set_id",
    "rule_set_version",
    "status",
    "currency",
    "supported_reporting_period",
    "registration_thresholds",
    "ld2_amount_rules",
    "open_questions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "rule_set_id": {
      "const": "lda.money.v1"
    },
    "rule_set_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": ["draft", "accepted", "retired"]
    },
    "currency": {
      "const": "USD"
    },
    "supported_reporting_period": {
      "$ref": "#/$defs/period"
    },
    "registration_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/registrationPeriod"
      }
    },
    "ld2_amount_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/amountRule"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "minorUnits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "through": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrieved_on"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "coverageThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minor_units",
        "exemption_comparison",
        "calculation_use"
      ],
      "properties": {
        "minor_units": {
          "$ref": "#/$defs/minorUnits"
        },
        "exemption_comparison": {
          "const": "less_than_or_equal"
        },
        "calculation_use": {
          "const": "coverage_boundary_only"
        }
      }
    },
    "registrationPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_period",
        "lobbying_firm_income",
        "in_house_lobbying_expenses",
        "authority"
      ],
      "properties": {
        "effective_period": {
          "$ref": "#/$defs/period"
        },
        "lobbying_firm_income": {
          "$ref": "#/$defs/coverageThreshold"
        },
        "in_house_lobbying_expenses": {
          "$ref": "#/$defs/coverageThreshold"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        }
      }
    },
    "reportedBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_minor_units",
        "upper_minor_units",
        "lower_inclusive",
        "upper_inclusive",
        "measurement_kind"
      ],
      "properties": {
        "lower_minor_units": {
          "$ref": "#/$defs/minorUnits"
        },
        "upper_minor_units": {
          "$ref": "#/$defs/minorUnits"
        },
        "lower_inclusive": {
          "type": "boolean"
        },
        "upper_inclusive": {
          "type": "boolean"
        },
        "measurement_kind": {
          "const": "threshold_band"
        }
      }
    },
    "numericReporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_minor_units",
        "minimum_inclusive",
        "measurement_kind",
        "precision_increment_minor_units",
        "derived_interval_policy"
      ],
      "properties": {
        "minimum_minor_units": {
          "$ref": "#/$defs/minorUnits"
        },
        "minimum_inclusive": {
          "type": "boolean"
        },
        "measurement_kind": {
          "enum": ["rounded_estimate", "method_specific_reported_value"]
        },
        "precision_increment_minor_units": {
          "oneOf": [
            { "$ref": "#/$defs/minorUnits" },
            { "type": "null" }
          ]
        },
        "derived_interval_policy": {
          "enum": [
            "blocked_pending_rounding_boundary_rule",
            "not_authorized_without_accounting_method_rule"
          ]
        }
      }
    },
    "amountRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_period",
        "semantic_role",
        "accounting_methods",
        "under_reporting_threshold",
        "numeric_reporting",
        "authority"
      ],
      "properties": {
        "effective_period": {
          "$ref": "#/$defs/period"
        },
        "semantic_role": {
          "enum": ["lobbying_income", "lobbying_expense"]
        },
        "accounting_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["lda_income", "A", "B", "C"]
          }
        },
        "under_reporting_threshold": {
          "$ref": "#/$defs/reportedBand"
        },
        "numeric_reporting": {
          "$ref": "#/$defs/numericReporting"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        }
      }
    }
  }
}
