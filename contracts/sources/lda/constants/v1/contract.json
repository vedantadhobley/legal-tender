      "representation": "canonical_json",
      "source_url": "https://lda.gov/api/v1/constants/contribution/itemtypes/",
      "retrieved_on": "2026-08-27",
      "sha256": "417303874c13b8b30c746d00e4834665d7a85ef75725224b80c249f963d478fd",
