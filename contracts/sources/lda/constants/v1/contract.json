{
  "$schema": "../../../../source-contract.schema.json",
  "contract_id": "lda/constants",
  "contract_version": "1.0.0",
  "status": "draft",
  "publisher": {
    "id": "lda",
    "name": "Lobbying Disclosure Act public disclosure system",
    "base_url": "https://lda.gov/"
  },
  "dataset": {
    "id": "constants",
    "name": "LDA publisher code lists",
    "semantic_domain": "federal_lobbying_reference",
    "description": "Publisher labels for filing types, issue codes, government entities, geographies, lobbyist affixes, and contribution-item types."
  },
  "authority": [
    {
      "kind": "api",
      "url": "https://lda.gov/api/v1/",
      "retrieved_on": "2026-08-27"
    },
    {
      "kind": "openapi",
      "url": "https://lda.gov/api/openapi/v1/",
      "retrieved_on": "2026-08-27",
      "sha256": "6c5f13c470bf1b4b09071db32d10df72372210fd2c2be921214e3c94f47dde8a"
    },
    {
      "kind": "documentation",
      "url": "https://lda.gov/api/redoc/v1/",
      "retrieved_on": "2026-08-27"
    },
    {
      "kind": "terms",
      "url": "https://lda.gov/api/tos/",
      "retrieved_on": "2026-08-27"
    }
  ],
  "acquisition": {
    "authentication": {
      "class": "api_token",
      "environment_variable": "LOBBYING_API_KEY",
      "header": "Authorization",
      "scheme": "Token"
    },
    "endpoints": [
      {
        "name": "filing-types",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/filing/filingtypes/",
        "response_root": "$[]"
      },
      {
        "name": "lobbying-activity-issues",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/filing/lobbyingactivityissues/",
        "response_root": "$[]"
      },
      {
        "name": "government-entities",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/filing/governmententities/",
        "response_root": "$[]"
      },
      {
        "name": "countries",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/general/countries/",
        "response_root": "$[]"
      },
      {
        "name": "states",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/general/states/",
        "response_root": "$[]"
      },
      {
        "name": "lobbyist-prefixes",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/lobbyist/prefixes/",
        "response_root": "$[]"
      },
      {
        "name": "lobbyist-suffixes",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/lobbyist/suffixes/",
        "response_root": "$[]"
      },
      {
        "name": "contribution-item-types",
        "method": "GET",
        "url": "https://lda.gov/api/v1/constants/contribution/itemtypes/",
        "response_root": "$[]"
      }
    ],
    "pagination": "Constants endpoints return one unpaginated JSON array.",
    "rate_limit_per_minute": 120,
    "partitions": [
      {
        "name": "retrieved_date",
        "source": "Legal Tender retrieval date",
        "purpose": "Immutable code-list snapshot and drift comparison."
      }
    ],
    "retry_policy": "Capture every endpoint in one logical snapshot; any missing endpoint blocks the combined constants publication."
  },
  "physical_schema": {
    "media_type": "application/json",
    "record_schema": "record.schema.json",
    "unknown_field_policy": "capture_and_review",
    "null_policy": "Preserve source values exactly; missing name or code becomes an explicit issue.",
    "schema_fingerprint": "Endpoint identity plus sorted object keys and JSON kinds, code membership, and this contract version."
  },
  "identity": {
    "publisher_record_key": "endpoint + value, or endpoint + id for government entities",
    "occurrence_locator": "snapshot digest + endpoint + one-based array ordinal",
    "record_version": "endpoint + source key + SHA-256 of canonical item JSON",
    "duplicate_policy": "Preserve duplicate occurrences and block conflicting names for one endpoint-scoped key.",
    "children": []
  },
  "semantics": {
    "time_fields": [],
    "money_fields": [],
    "code_fields": [
      {
        "path": "value",
        "meaning": "Publisher code within its endpoint namespace."
      },
      {
        "path": "id",
        "meaning": "Publisher numeric government-entity ID within the government-entities endpoint."
      },
      {
        "path": "name",
        "meaning": "Publisher display label; never a replacement for the source code."
      }
    ],
    "rules": [
      "Constants are immutable snapshots even though the publisher endpoint is mutable.",
      "Unknown codes in a filing remain valid raw text with an issue until reviewed.",
      "A display-name change creates a new constants record version."
    ]
  },
  "revisions": {
    "publisher_model": "The API exposes current code lists without historical version identifiers.",
    "effective_projection": "Retain every retrieved snapshot; parser contracts reference an accepted snapshot digest."
  },
  "quality": {
    "checks": [
      {
        "id": "endpoint_complete",
        "severity": "block",
        "rule": "All eight accepted constants endpoints are present in one logical snapshot."
      },
      {
        "id": "key_unique",
        "severity": "block",
        "rule": "Endpoint-scoped values or IDs are unique unless preserved as explicit conflicts."
      },
      {
        "id": "display_present",
        "severity": "block",
        "rule": "Every accepted constant has a non-empty publisher display name."
      },
      {
        "id": "membership_change",
        "severity": "observe",
        "rule": "Added, removed, or renamed constants emit schema-review evidence."
      }
    ]
  },
  "fixtures": [
    {
      "path": "fixtures/filing-types.json",
      "representation": "canonical_json",
      "source_url": "https://lda.gov/api/v1/constants/filing/filingtypes/",
