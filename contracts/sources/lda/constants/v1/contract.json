      ]
    }
  ],
  "use": {
    "retention": "Preserve complete API responses, record occurrences, source documents selected by policy, and every accepted version indefinitely.",
    "citation_date_required": true,
    "disclaimer": "Senate Office of Public Records cannot vouch for the data or analyses derived from these data after the data have been retrieved from LDA.gov."
  },
  "outputs": {
    "fact_types": [
      "lda.constant_snapshot.v1",
      "lda.constant_assertion.v1"
    ],
    "change_dimensions": [
      "constants_endpoint",
      "source_code",
      "government_entity_id"
    ]
  }
}
