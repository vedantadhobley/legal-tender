{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/api/committee-flow/v1/response.schema.json",
  "title": "Read-only pinned committee-flow evidence response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "data"
      ],
      "properties": {
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "data": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/page"
            },
            {
              "$ref": "#/$defs/entity"
            },
            {
              "$ref": "#/$defs/component"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "enum": [
            "invalid_query",
            "not_found",
            "projection_mismatch",
            "query_timeout",
            "evidence_unavailable",
            "method_not_allowed",
            "request_capacity_exceeded",
            "response_limit_or_encoding_failure"
          ]
        }
      }
    }
  ],
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "projection_id",
        "cycle",
        "state",
        "bundle_id",
        "bundle_sha256",
        "calculation_set_id",
        "inputs",
        "entities",
        "unresolved_same_cycle_masters",
        "schedule_a",
        "schedule_b",
        "economic_flow_status",
        "terminal_attribution_eligible"
      ],
      "properties": {
        "schema_version": {
          "const": "legal-tender.committee-flow-api.v1"
        },
        "projection_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cycle": {
          "type": "string",
          "pattern": "^[0-9]{3}[02468]$"
        },
        "state": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calculation_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/result.schema.json#/properties/input"
        },
        "entities": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_same_cycle_masters": {
          "type": "integer",
          "minimum": 0
        },
        "schedule_a": {
          "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/result.schema.json#/$defs/measures"
        },
        "schedule_b": {
          "$ref": "https://legal-tender.local/contracts/calculations/fec/committee-flow-reconciliation/v1/result.schema.json#/$defs/measures"
        },
        "economic_flow_status": {
          "const": "not_established"
        },
        "terminal_attribution_eligible": {
          "const": false
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "_key",
        "cycle",
        "committee_id",
        "identity_state",
        "master_fact_set_id",
        "master_fact_id",
        "master",
        "terminal_attribution_eligible"
      ],
      "properties": {
        "_key": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "cycle": {
          "type": "string"
        },
        "committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "identity_state": {
          "enum": [
            "same_cycle_master",
            "unresolved_same_cycle_master"
          ]
        },
        "master_fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "master_fact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "master": {
          "type": [
            "object",
            "null"
          ]
        },
        "terminal_attribution_eligible": {
          "const": false
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "_key",
        "_from",
        "_to",
        "schema_version",
        "cycle",
        "ledger",
        "fact_set_id",
        "calculation_set_id",
        "selection_policy",
        "reporting_policy",
        "matching_policy",
        "component_id",
        "economic_flow_status",
        "terminal_attribution_eligible",
        "source_row_ordinal",
        "sub_id",
        "sender_committee_id",
        "reported_recipient_committee_id",
        "flow_role",
        "transaction_type",
        "reporting_role",
        "date_days",
        "signed_amount_minor_units"
      ],
      "properties": {
        "_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "_from": {
          "type": "string",
          "pattern": "^entities/C[0-9]{8}$"
        },
        "_to": {
          "type": "string",
          "pattern": "^entities/C[0-9]{8}$"
        },
        "schema_version": {
          "const": "legal-tender.arango.committee-flow-evidence.v1"
        },
        "cycle": {
          "type": "string"
        },
        "ledger": {
          "enum": [
            "schedule_a",
            "schedule_b"
          ]
        },
        "fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calculation_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_policy": {
          "type": "string"
        },
        "reporting_policy": {
          "type": "string"
        },
        "matching_policy": {
          "type": "string"
        },
        "component_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "economic_flow_status": {
          "const": "not_established"
        },
        "terminal_attribution_eligible": {
          "const": false
        },
        "source_row_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "sub_id": {
          "type": "string"
        },
        "sender_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "reported_recipient_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "flow_role": {
          "type": "string"
        },
        "transaction_type": {
          "type": "string"
        },
        "reporting_role": {
          "type": "string"
        },
        "date_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signed_amount_minor_units": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "_key",
        "cycle",
        "sender_committee_id",
        "reported_recipient_committee_id",
        "calculation_set_id",
        "matching_policy",
        "schedule_a_fact_set_id",
        "schedule_b_fact_set_id",
        "economic_flow_status",
        "terminal_attribution_eligible",
        "assertion_id",
        "state",
        "schedule_a_amount_minor_units",
        "schedule_b_amount_minor_units",
        "schedule_a_members",
        "schedule_b_members"
      ],
      "properties": {
        "_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cycle": {
          "type": "string"
        },
        "sender_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "reported_recipient_committee_id": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "calculation_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "matching_policy": {
          "type": "string"
        },
        "schedule_a_fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schedule_b_fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "economic_flow_status": {
          "const": "not_established"
        },
        "terminal_attribution_eligible": {
          "const": false
        },
        "assertion_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "type": "string"
        },
        "schedule_a_amount_minor_units": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "schedule_b_amount_minor_units": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "schedule_a_members": {
          "type": "integer",
          "minimum": 0
        },
        "schedule_b_members": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "fact_set_id",
        "source_row_ordinal",
        "shard_sha256",
        "fields"
      ],
      "properties": {
        "side": {
          "enum": [
            "schedule_a",
            "schedule_b"
          ]
        },
        "fact_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_row_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "shard_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "vertices",
        "observations"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 2048
        },
        "vertices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ledger",
        "limit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entities",
            "observations",
            "members",
            "neighborhood",
            "paths",
            "cycles",
            "shortest"
          ]
        },
        "ledger": {
          "enum": [
            "",
            "schedule_a",
            "schedule_b"
          ]
        },
        "committee": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound",
            "any"
          ]
        },
        "component": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "type": "string",
          "pattern": "^C[0-9]{8}$"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "items",
        "has_more",
        "next_cursor",
        "coverage_scope"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/query"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/entity"
              },
              {
                "$ref": "#/$defs/observation"
              },
              {
                "$ref": "#/$defs/path"
              }
            ]
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "coverage_scope": {
          "enum": [
            "selected_observations_in_pinned_projection",
            "referenced_committee_identities_in_pinned_projection",
            "paths_within_requested_depth_not_global_graph_coverage",
            "one_hop_shortest_path_within_requested_depth"
          ]
        }
      }
    }
  }
}
