{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/releases/fec/v4/inventory.schema.json",
  "title": "Legal Tender FEC release inventory v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "inventory_version",
    "periods",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "legal-tender.fec.release-inventory.v4"
    },
    "inventory_version": {
      "const": "legal-tender.fec.initial-release-inventory.v4"
    },
    "periods": {
      "$ref": "#/$defs/periods"
    },
    "sources": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "period": {
      "enum": [
        "2020",
        "2022",
        "2024",
        "2026"
      ]
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "fact_family",
        "source_contract",
        "request_url",
        "periods",
        "selected_members",
        "selected_relations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^fec:[a-z-]+:(2020|2022|2024|2026|processed)$"
        },
        "fact_family": {
          "enum": [
            "candidate_master",
            "committee_master",
            "candidate_committee_linkage",
            "all_candidates_summary",
            "current_campaigns_summary",
            "processed_schedule_a",
            "processed_schedule_b",
            "processed_schedule_e",
            "committee_summary"
          ]
        },
        "source_contract": {
          "type": "string",
          "pattern": "^fec/[a-z-]+@[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "request_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.fec\\.gov/"
        },
        "periods": {
          "$ref": "#/$defs/periods"
        },
        "selected_members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation_selections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation_selection"
          }
        },
        "artifact_format": {
          "const": "committee_summary_csv"
        }
      }
    },
    "relation_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "field_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "2020",
            "2022",
            "2024",
            "2026",
            "all_history"
          ]
        },
        "field_count": {
          "enum": [
            80,
            81
          ]
        },
        "materialization": {
          "enum": [
            "staged_copy_zstd",
            "archive_direct"
          ]
        }
      }
    }
  }
}
