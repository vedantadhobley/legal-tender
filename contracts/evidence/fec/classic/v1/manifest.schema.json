{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/evidence/fec/classic/v1/manifest.schema.json",
  "title": "Published classic FEC occurrence set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "occurrence_set_id", "dataset",
    "source_contract", "source_id", "source_release_id",
    "source_release_manifest_sha256", "source_artifact_sha256",
    "staged_output_sha256", "member", "cycle", "run_id", "state",
    "parser_version", "semantic_schema_version", "published_at", "counts",
    "changes", "artifacts", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.classic-occurrence-set.v1"},
    "occurrence_set_id": {"$ref": "#/$defs/digest"},
    "prior_occurrence_set_id": {"$ref": "#/$defs/digest"},
    "dataset": {
      "enum": [
        "candidate-master", "committee-master", "candidate-committee-linkage",
        "all-candidates-summary", "current-campaigns-summary"
      ]
    },
    "source_contract": {
      "enum": [
        "fec/candidate-master@1.0.0", "fec/committee-master@1.0.0",
        "fec/candidate-committee-linkage@1.0.0",
        "fec/all-candidates-summary@1.0.0",
        "fec/current-campaigns-summary@1.0.0"
      ]
    },
    "source_id": {"type": "string", "pattern": "^fec:(cn|cm|ccl|weball|webl):[0-9]{4}$"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "source_release_manifest_sha256": {"$ref": "#/$defs/digest"},
    "source_artifact_sha256": {"$ref": "#/$defs/digest"},
    "staged_output_sha256": {"$ref": "#/$defs/digest"},
    "member": {"type": "string", "pattern": "^(cn|cm|ccl|weball[0-9]{2}|webl[0-9]{2})\\.txt$"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "parser_version": {"const": "legal-tender.fec.classic-occurrence-parser.v2"},
    "semantic_schema_version": {"const": "legal-tender.fec.classic-semantic-digest.v1"},
    "published_at": {"type": "string", "format": "date-time"},
    "counts": {"$ref": "#/$defs/counts"},
    "changes": {"$ref": "#/$defs/changes"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrences", "issues", "natural_index", "changes"],
      "properties": {
        "occurrences": {"$ref": "#/$defs/artifact"},
        "issues": {"$ref": "#/$defs/artifact"},
        "natural_index": {"$ref": "#/$defs/artifact"},
        "changes": {"$ref": "#/$defs/artifact"}
      }
    },
    "checks": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "valid", "invalid", "keyed", "unique_keys", "invalid_keys", "duplicate_keys", "duplicate_occurrences"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "valid": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0},
        "keyed": {"type": "integer", "minimum": 0},
        "unique_keys": {"type": "integer", "minimum": 0},
        "invalid_keys": {"type": "integer", "minimum": 0},
        "duplicate_keys": {"type": "integer", "minimum": 0},
        "duplicate_occurrences": {"type": "integer", "minimum": 0}
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "absent", "unchanged", "invalid"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "absent": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "uncompressed_byte_count", "uncompressed_sha256", "compressed_byte_count", "compressed_sha256", "compression", "storage_key"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_byte_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "compressed_byte_count": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "compression": {"const": "zstd"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
