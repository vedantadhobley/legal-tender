{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_set_id",
    "fact_type",
    "state",
    "cycle",
    "source_contract",
    "parser_version",
    "source_release_id",
    "source_release_manifest_sha256",
    "source_artifact",
    "run_id",
    "published_at",
    "verification",
    "facts",
    "readback_verified",
    "terminal_attribution_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "legal-tender.fec.committee-summary-fact-set.v1"
    },
    "fact_set_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fact_type": {
      "const": "fec.committee_summary.v1"
    },
    "state": {
      "const": "published"
    },
    "cycle": {
      "type": "string",
      "pattern": "^[0-9]{3}[02468]$"
    },
    "source_contract": {
      "const": "fec/committee-summary@1.0.0"
    },
    "parser_version": {
      "const": "legal-tender.fec.committee-summary-reader.v1"
    },
    "source_release_id": {
      "type": "string",
      "pattern": "^fec-[a-f0-9]{64}$"
    },
    "source_release_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_artifact": {
      "$ref": "../../../../releases/fec/v4/release-manifest.schema.json#/$defs/artifact"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "$ref": "../../../../audits/fec/committee-summary-verification/v1/result.schema.json"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "uncompressed_byte_count",
        "uncompressed_sha256",
        "compressed_byte_count",
        "compressed_sha256",
        "compression",
        "storage_key"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "uncompressed_byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "uncompressed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compressed_byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "compressed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compression": {
          "const": "zstd"
        },
        "storage_key": {
          "type": "string",
          "pattern": "^facts/fec/committee-summary/v1/facts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.jsonl\\.zst$"
        }
      }
    },
    "readback_verified": {
      "const": true
    },
    "terminal_attribution_eligible": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/facts/fec/committee-summary/v1/manifest.schema.json"
}
