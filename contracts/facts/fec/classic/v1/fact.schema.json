{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/facts/fec/classic/v1/fact.schema.json",
  "title": "Classic FEC normalized fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "fact_type", "dataset", "cycle", "natural_key", "occurrence_set_id", "occurrence_id", "record_version_id", "source_release_id", "source_contract", "state", "issue_codes", "source_fields", "typed_fields"],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.classic-fact.v1"},
    "fact_id": {"$ref": "#/$defs/digest"},
    "fact_type": {"enum": ["fec.candidate_assertion.v1", "fec.committee_assertion.v1", "fec.candidate_committee_linkage.v1", "fec.candidate_summary_all.v1", "fec.campaign_summary.v1"]},
    "dataset": {"enum": ["candidate-master", "committee-master", "candidate-committee-linkage", "all-candidates-summary", "current-campaigns-summary"]},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "natural_key": {"type": "string", "minLength": 1},
    "occurrence_set_id": {"$ref": "#/$defs/digest"},
    "occurrence_id": {"$ref": "#/$defs/digest"},
    "record_version_id": {"$ref": "#/$defs/digest"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "source_contract": {"type": "string", "minLength": 1},
    "state": {"enum": ["valid", "invalid"]},
    "issue_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "source_fields": {"type": "object", "minProperties": 7, "additionalProperties": {"type": "string"}},
    "typed_fields": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "optionalString": {"type": ["string", "null"]},
    "moneyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "reported_minor_units", "observation_state", "measurement_kind", "currency"],
      "properties": {
        "raw_value": {"type": "string"},
        "reported_minor_units": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)$"},
        "observation_state": {"enum": ["reported_value", "source_blank", "invalid"]},
        "measurement_kind": {"const": "summary_value"},
        "currency": {"const": "USD"}
      }
    },
    "candidateTyped": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "name", "party_affiliation", "candidate_election_year", "source_cycle", "office_state", "office", "office_district", "incumbent_challenger_open", "candidate_status", "principal_campaign_committee_id", "street_1", "street_2", "city", "state", "zip"],
      "properties": {
        "candidate_id": {"type": "string"}, "name": {"type": "string"}, "party_affiliation": {"type": "string"},
        "candidate_election_year": {"type": "integer"}, "source_cycle": {"type": "integer"},
        "office_state": {"type": "string"}, "office": {"type": "string"}, "office_district": {"type": "string"},
        "incumbent_challenger_open": {"type": "string"}, "candidate_status": {"type": "string"},
        "principal_campaign_committee_id": {"$ref": "#/$defs/optionalString"},
        "street_1": {"type": "string"}, "street_2": {"type": "string"}, "city": {"type": "string"}, "state": {"type": "string"}, "zip": {"type": "string"}
      }
    },
    "committeeTyped": {
      "type": "object", "additionalProperties": false,
      "required": ["committee_id", "name", "treasurer_name", "street_1", "street_2", "city", "state", "zip", "designation_code", "committee_type_code", "party_affiliation", "filing_frequency_code", "organization_type_code", "connected_organization", "candidate_id", "source_cycle"],
      "properties": {
        "committee_id": {"type": "string"}, "name": {"type": "string"}, "treasurer_name": {"type": "string"},
        "street_1": {"type": "string"}, "street_2": {"type": "string"}, "city": {"type": "string"}, "state": {"type": "string"}, "zip": {"type": "string"},
        "designation_code": {"type": "string"}, "committee_type_code": {"type": "string"}, "party_affiliation": {"type": "string"},
        "filing_frequency_code": {"type": "string"}, "organization_type_code": {"type": "string"}, "connected_organization": {"type": "string"},
        "candidate_id": {"$ref": "#/$defs/optionalString"}, "source_cycle": {"type": "integer"}
      }
    },
    "linkageTyped": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "candidate_election_year", "fec_election_year", "source_cycle", "committee_id", "committee_type_code", "designation_code", "linkage_id"],
      "properties": {
        "candidate_id": {"type": "string"}, "candidate_election_year": {"type": "integer"}, "fec_election_year": {"type": "integer"},
        "source_cycle": {"type": "integer"}, "committee_id": {"type": "string"}, "committee_type_code": {"type": "string"},
        "designation_code": {"type": "string"}, "linkage_id": {"type": "string"}
      }
    },
    "summaryTyped": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "name", "incumbent_code", "party_code", "party_affiliation", "office_state", "office_district", "coverage_through", "source_cycle", "money"],
      "properties": {
        "candidate_id": {"type": "string"}, "name": {"type": "string"}, "incumbent_code": {"type": "string"}, "party_code": {"type": "string"},
        "party_affiliation": {"type": "string"}, "office_state": {"type": "string"}, "office_district": {"type": "string"},
        "coverage_through": {"type": ["string", "null"], "format": "date"}, "source_cycle": {"type": "integer"},
        "money": {
          "type": "object", "additionalProperties": false,
          "required": ["TTL_RECEIPTS", "TRANS_FROM_AUTH", "TTL_DISB", "TRANS_TO_AUTH", "COH_BOP", "COH_COP", "CAND_CONTRIB", "CAND_LOANS", "OTHER_LOANS", "CAND_LOAN_REPAY", "OTHER_LOAN_REPAY", "DEBTS_OWED_BY", "TTL_INDIV_CONTRIB", "OTHER_POL_CMTE_CONTRIB", "POL_PTY_CONTRIB", "INDIV_REFUNDS", "CMTE_REFUNDS"],
          "properties": {
            "TTL_RECEIPTS": {"$ref": "#/$defs/moneyObservation"}, "TRANS_FROM_AUTH": {"$ref": "#/$defs/moneyObservation"},
            "TTL_DISB": {"$ref": "#/$defs/moneyObservation"}, "TRANS_TO_AUTH": {"$ref": "#/$defs/moneyObservation"},
            "COH_BOP": {"$ref": "#/$defs/moneyObservation"}, "COH_COP": {"$ref": "#/$defs/moneyObservation"},
            "CAND_CONTRIB": {"$ref": "#/$defs/moneyObservation"}, "CAND_LOANS": {"$ref": "#/$defs/moneyObservation"},
            "OTHER_LOANS": {"$ref": "#/$defs/moneyObservation"}, "CAND_LOAN_REPAY": {"$ref": "#/$defs/moneyObservation"},
            "OTHER_LOAN_REPAY": {"$ref": "#/$defs/moneyObservation"}, "DEBTS_OWED_BY": {"$ref": "#/$defs/moneyObservation"},
            "TTL_INDIV_CONTRIB": {"$ref": "#/$defs/moneyObservation"}, "OTHER_POL_CMTE_CONTRIB": {"$ref": "#/$defs/moneyObservation"},
            "POL_PTY_CONTRIB": {"$ref": "#/$defs/moneyObservation"}, "INDIV_REFUNDS": {"$ref": "#/$defs/moneyObservation"},
            "CMTE_REFUNDS": {"$ref": "#/$defs/moneyObservation"}
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"dataset": {"const": "candidate-master"}}}, "then": {"properties": {"fact_type": {"const": "fec.candidate_assertion.v1"}, "typed_fields": {"$ref": "#/$defs/candidateTyped"}}}},
    {"if": {"properties": {"dataset": {"const": "committee-master"}}}, "then": {"properties": {"fact_type": {"const": "fec.committee_assertion.v1"}, "typed_fields": {"$ref": "#/$defs/committeeTyped"}}}},
    {"if": {"properties": {"dataset": {"const": "candidate-committee-linkage"}}}, "then": {"properties": {"fact_type": {"const": "fec.candidate_committee_linkage.v1"}, "typed_fields": {"$ref": "#/$defs/linkageTyped"}}}},
    {"if": {"properties": {"dataset": {"const": "all-candidates-summary"}}}, "then": {"properties": {"fact_type": {"const": "fec.candidate_summary_all.v1"}, "typed_fields": {"$ref": "#/$defs/summaryTyped"}}}},
    {"if": {"properties": {"dataset": {"const": "current-campaigns-summary"}}}, "then": {"properties": {"fact_type": {"const": "fec.campaign_summary.v1"}, "typed_fields": {"$ref": "#/$defs/summaryTyped"}}}},
    {"if": {"properties": {"state": {"const": "valid"}}}, "then": {"properties": {"issue_codes": {"maxItems": 0}}}},
    {"if": {"properties": {"state": {"const": "invalid"}}}, "then": {"properties": {"issue_codes": {"minItems": 1}}}}
  ]
}
