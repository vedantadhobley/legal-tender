{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/facts/fec/schedule-e/v1/manifest.schema.json",
  "title": "Published processed Schedule E independent-expenditure fact set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "fact_set_id", "fact_type", "cycle",
    "source_contract", "source_release_id", "source_release_manifest_sha256",
    "occurrence_set_id", "occurrence_manifest_sha256", "run_id", "state",
    "normalizer_version", "fact_schema_version", "published_at", "counts",
    "facts", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.schedule-e-fact-set.v1"},
    "fact_set_id": {"$ref": "#/$defs/digest"},
    "fact_type": {"const": "fec.schedule_e_independent_expenditure.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_contract": {"const": "fec/schedule-e@1.0.0"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "source_release_manifest_sha256": {"$ref": "#/$defs/digest"},
    "occurrence_set_id": {"$ref": "#/$defs/digest"},
    "occurrence_manifest_sha256": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "normalizer_version": {"const": "legal-tender.fec.schedule-e-normalizer.v1"},
    "fact_schema_version": {"const": "legal-tender.fec.schedule-e-independent-expenditure.v1"},
    "published_at": {"type": "string", "format": "date-time"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["source_occurrences", "facts", "valid_facts", "invalid_facts"],
      "properties": {
        "source_occurrences": {"type": "integer", "minimum": 0},
        "facts": {"type": "integer", "minimum": 0},
        "valid_facts": {"type": "integer", "minimum": 0},
        "invalid_facts": {"type": "integer", "minimum": 0}
      }
    },
    "facts": {"$ref": "#/$defs/artifact"},
    "checks": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["record_count", "uncompressed_byte_count", "uncompressed_sha256", "compressed_byte_count", "compressed_sha256", "compression", "storage_key"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "uncompressed_byte_count": {"type": "integer", "minimum": 0},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "compressed_byte_count": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "compression": {"const": "zstd"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
