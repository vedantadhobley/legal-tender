{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/facts/fec/schedule-a/columnar/v1/manifest.schema.json",
  "title": "Published processed Schedule A columnar fact set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "fact_set_id", "fact_type", "cycle",
    "source_contract", "source_release_id", "source_release_manifest_sha256",
    "occurrence_set_id", "occurrence_manifest_sha256", "run_id", "state",
    "normalizer_version", "fact_schema_version", "physical_schema_version",
    "publisher_version", "parquet_library", "published_at", "configuration",
    "counts", "source_replay", "shards", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.schedule-a-columnar-fact-set.v1"},
    "fact_set_id": {"$ref": "#/$defs/digest"},
    "fact_type": {"const": "fec.schedule_a_receipt.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_contract": {"const": "fec/schedule-a@1.0.0"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "source_release_manifest_sha256": {"$ref": "#/$defs/digest"},
    "occurrence_set_id": {"$ref": "#/$defs/digest"},
    "occurrence_manifest_sha256": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "published"},
    "normalizer_version": {"const": "legal-tender.fec.schedule-a-normalizer.v1"},
    "fact_schema_version": {"const": "legal-tender.fec.schedule-a-receipt.v1"},
    "physical_schema_version": {"const": "legal-tender.fec.schedule-a-parquet.v1"},
    "publisher_version": {"const": "legal-tender.fec.schedule-a-columnar-publisher.v1"},
    "parquet_library": {"const": "github.com/parquet-go/parquet-go@v0.32.0"},
    "published_at": {"type": "string", "format": "date-time"},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["rows_per_shard", "rows_per_row_group", "column_count", "compression", "locator"],
      "properties": {
        "rows_per_shard": {"type": "integer", "minimum": 1},
        "rows_per_row_group": {"type": "integer", "minimum": 1},
        "column_count": {"const": 99},
        "compression": {"const": "parquet-zstd"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "counts": {"$ref": "#/$defs/counts"},
    "source_replay": {"$ref": "#/$defs/sourceReplay"},
    "shards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shard"}},
    "checks": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["source_occurrences", "facts", "valid_facts", "invalid_facts", "excluded_occurrences", "source_invalid_occurrences", "source_duplicate_occurrences"],
      "properties": {
        "source_occurrences": {"type": "integer", "minimum": 0},
        "facts": {"type": "integer", "minimum": 0},
        "valid_facts": {"type": "integer", "minimum": 0},
        "invalid_facts": {"type": "integer", "minimum": 0},
        "excluded_occurrences": {"type": "integer", "minimum": 0},
        "source_invalid_occurrences": {"type": "integer", "minimum": 0},
        "source_duplicate_occurrences": {"type": "integer", "minimum": 0}
      }
    },
    "sourceReplay": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "compressed_bytes", "compressed_sha256", "uncompressed_bytes", "uncompressed_sha256", "fact_semantic_sha256"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "compressed_bytes": {"type": "integer", "minimum": 1},
        "compressed_sha256": {"$ref": "#/$defs/digest"},
        "uncompressed_bytes": {"type": "integer", "minimum": 1},
        "uncompressed_sha256": {"$ref": "#/$defs/digest"},
        "fact_semantic_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "first_source_row_ordinal", "last_source_row_ordinal", "first_raw_byte_offset", "last_raw_byte_end", "source_rows", "facts", "valid_facts", "invalid_facts", "row_groups", "bytes", "sha256", "semantic_sha256", "storage_key"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "first_source_row_ordinal": {"type": "integer", "minimum": 1},
        "last_source_row_ordinal": {"type": "integer", "minimum": 1},
        "first_raw_byte_offset": {"type": "integer", "minimum": 0},
        "last_raw_byte_end": {"type": "integer", "minimum": 1},
        "source_rows": {"type": "integer", "minimum": 1},
        "facts": {"type": "integer", "minimum": 0},
        "valid_facts": {"type": "integer", "minimum": 0},
        "invalid_facts": {"type": "integer", "minimum": 0},
        "row_groups": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "semantic_sha256": {"$ref": "#/$defs/digest"},
        "storage_key": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
