{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/facts/fec/schedule-a/v1/fact.schema.json",
  "title": "Processed Schedule A receipt fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "fact_type", "cycle", "natural_key", "occurrence_set_id", "occurrence_id", "record_version_id", "source_release_id", "source_contract", "state", "issue_codes", "source_fields", "typed_fields"],
  "properties": {
    "schema_version": {"const": "legal-tender.fec.schedule-a-receipt.v1"},
    "fact_id": {"$ref": "#/$defs/digest"},
    "fact_type": {"const": "fec.schedule_a_receipt.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "natural_key": {"type": "string", "pattern": "^fec:schedule-a:[0-9]{4}:[0-9]+$"},
    "occurrence_set_id": {"$ref": "#/$defs/digest"},
    "occurrence_id": {"$ref": "#/$defs/digest"},
    "record_version_id": {"$ref": "#/$defs/digest"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "source_contract": {"const": "fec/schedule-a@1.0.0"},
    "state": {"enum": ["valid", "invalid"]},
    "issue_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "source_fields": {"$ref": "../../../../sources/fec/schedule-a/v1/record.schema.json"},
    "typed_fields": {"$ref": "#/$defs/typedFields"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "optionalString": {"type": ["string", "null"]},
    "optionalInteger": {"type": ["integer", "null"]},
    "optionalBoolean": {"type": ["boolean", "null"]},
    "localTimestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"},
    "money": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_role", "currency", "raw_value", "reported_minor_units", "source_scale", "observation_state", "measurement_kind", "source_rule_version"],
      "properties": {
        "semantic_role": {"enum": ["receipt", "contributor_aggregate_ytd"]},
        "currency": {"const": "USD"},
        "raw_value": {"type": ["string", "null"]},
        "reported_minor_units": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)$"},
        "source_scale": {"type": ["integer", "null"], "minimum": 0},
        "observation_state": {"enum": ["reported_value", "source_null", "invalid"]},
        "measurement_kind": {"const": "reported_point"},
        "source_rule_version": {"const": "fec/schedule-a@1.0.0"}
      }
    },
    "recipient": {
      "type": "object", "additionalProperties": false,
      "required": ["committee_id", "name", "committee_type_code", "organization_type_code", "designation_code"],
      "properties": {
        "committee_id": {"$ref": "#/$defs/optionalString"}, "name": {"$ref": "#/$defs/optionalString"},
        "committee_type_code": {"$ref": "#/$defs/optionalString"}, "organization_type_code": {"$ref": "#/$defs/optionalString"},
        "designation_code": {"$ref": "#/$defs/optionalString"}
      }
    },
    "contributor": {
      "type": "object", "additionalProperties": false,
      "required": ["contributor_id", "clean_contributor_id", "name", "first_name", "middle_name", "last_name", "prefix", "suffix", "street_1", "street_2", "city", "state", "zip", "entity_type_code", "entity_type_description", "employer", "occupation", "normalized_name_text", "normalized_employer_text", "normalized_occupation_text", "donor_committee_name", "national_committee_nonfed_account", "publisher_classed_individual"],
      "properties": {
        "contributor_id": {"$ref": "#/$defs/optionalString"}, "clean_contributor_id": {"$ref": "#/$defs/optionalString"},
        "name": {"$ref": "#/$defs/optionalString"}, "first_name": {"$ref": "#/$defs/optionalString"}, "middle_name": {"$ref": "#/$defs/optionalString"},
        "last_name": {"$ref": "#/$defs/optionalString"}, "prefix": {"$ref": "#/$defs/optionalString"}, "suffix": {"$ref": "#/$defs/optionalString"},
        "street_1": {"$ref": "#/$defs/optionalString"}, "street_2": {"$ref": "#/$defs/optionalString"}, "city": {"$ref": "#/$defs/optionalString"},
        "state": {"$ref": "#/$defs/optionalString"}, "zip": {"$ref": "#/$defs/optionalString"},
        "entity_type_code": {"$ref": "#/$defs/optionalString"}, "entity_type_description": {"$ref": "#/$defs/optionalString"},
        "employer": {"$ref": "#/$defs/optionalString"}, "occupation": {"$ref": "#/$defs/optionalString"},
        "normalized_name_text": {"$ref": "#/$defs/optionalString"}, "normalized_employer_text": {"$ref": "#/$defs/optionalString"},
        "normalized_occupation_text": {"$ref": "#/$defs/optionalString"}, "donor_committee_name": {"$ref": "#/$defs/optionalString"},
        "national_committee_nonfed_account": {"$ref": "#/$defs/optionalString"}, "publisher_classed_individual": {"$ref": "#/$defs/optionalBoolean"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "name", "first_name", "middle_name", "last_name", "prefix", "suffix", "office_code", "office", "office_state", "office_state_name", "office_district"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/optionalString"}, "name": {"$ref": "#/$defs/optionalString"},
        "first_name": {"$ref": "#/$defs/optionalString"}, "middle_name": {"$ref": "#/$defs/optionalString"}, "last_name": {"$ref": "#/$defs/optionalString"},
        "prefix": {"$ref": "#/$defs/optionalString"}, "suffix": {"$ref": "#/$defs/optionalString"}, "office_code": {"$ref": "#/$defs/optionalString"},
        "office": {"$ref": "#/$defs/optionalString"}, "office_state": {"$ref": "#/$defs/optionalString"},
        "office_state_name": {"$ref": "#/$defs/optionalString"}, "office_district": {"$ref": "#/$defs/optionalString"}
      }
    },
    "conduit": {
      "type": "object", "additionalProperties": false,
      "required": ["committee_id", "name", "street_1", "street_2", "city", "state", "zip"],
      "properties": {
        "committee_id": {"$ref": "#/$defs/optionalString"}, "name": {"$ref": "#/$defs/optionalString"},
        "street_1": {"$ref": "#/$defs/optionalString"}, "street_2": {"$ref": "#/$defs/optionalString"},
        "city": {"$ref": "#/$defs/optionalString"}, "state": {"$ref": "#/$defs/optionalString"}, "zip": {"$ref": "#/$defs/optionalString"}
      }
    },
    "election": {
      "type": "object", "additionalProperties": false,
      "required": ["election_type_code", "fec_election_type", "election_type_description", "fec_election_year", "two_year_transaction_period", "increased_limit_code"],
      "properties": {
        "election_type_code": {"$ref": "#/$defs/optionalString"}, "fec_election_type": {"$ref": "#/$defs/optionalString"},
        "election_type_description": {"$ref": "#/$defs/optionalString"}, "fec_election_year": {"$ref": "#/$defs/optionalInteger"},
        "two_year_transaction_period": {"type": "integer"}, "increased_limit_code": {"$ref": "#/$defs/optionalString"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["received_at_local", "received_on", "amount", "contributor_aggregate_ytd", "receipt_type_code", "receipt_type", "description", "memo_code", "memo_code_description", "memo_text", "memoed_subtotal", "schedule_type_code", "schedule_type"],
      "properties": {
        "received_at_local": {"$ref": "#/$defs/localTimestamp"}, "received_on": {"type": ["string", "null"], "format": "date"},
        "amount": {"$ref": "#/$defs/money"}, "contributor_aggregate_ytd": {"$ref": "#/$defs/money"},
        "receipt_type_code": {"$ref": "#/$defs/optionalString"}, "receipt_type": {"$ref": "#/$defs/optionalString"},
        "description": {"$ref": "#/$defs/optionalString"}, "memo_code": {"$ref": "#/$defs/optionalString"},
        "memo_code_description": {"$ref": "#/$defs/optionalString"}, "memo_text": {"$ref": "#/$defs/optionalString"},
        "memoed_subtotal": {"type": "boolean"}, "schedule_type_code": {"$ref": "#/$defs/optionalString"},
        "schedule_type": {"$ref": "#/$defs/optionalString"}
      }
    },
    "filing": {
      "type": "object", "additionalProperties": false,
      "required": ["action_code", "action", "transaction_id", "back_reference_transaction_id", "back_reference_schedule_name", "line_number", "line_number_label", "image_number", "file_number", "link_id", "original_submission_id", "submission_id", "filing_form", "report_type_code", "report_year", "pdf_url", "publisher_loaded_at_local"],
      "properties": {
        "action_code": {"$ref": "#/$defs/optionalString"}, "action": {"$ref": "#/$defs/optionalString"},
        "transaction_id": {"$ref": "#/$defs/optionalString"}, "back_reference_transaction_id": {"$ref": "#/$defs/optionalString"},
        "back_reference_schedule_name": {"$ref": "#/$defs/optionalString"}, "line_number": {"$ref": "#/$defs/optionalString"},
        "line_number_label": {"$ref": "#/$defs/optionalString"}, "image_number": {"$ref": "#/$defs/optionalString"},
        "file_number": {"$ref": "#/$defs/optionalString"}, "link_id": {"$ref": "#/$defs/optionalString"},
        "original_submission_id": {"$ref": "#/$defs/optionalString"}, "submission_id": {"type": "string", "pattern": "^[0-9]+$"},
        "filing_form": {"type": "string", "minLength": 1}, "report_type_code": {"$ref": "#/$defs/optionalString"},
        "report_year": {"$ref": "#/$defs/optionalInteger"}, "pdf_url": {"$ref": "#/$defs/optionalString"},
        "publisher_loaded_at_local": {"$ref": "#/$defs/localTimestamp"}
      }
    },
    "typedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["recipient", "contributor", "candidate", "conduit", "election", "receipt", "filing"],
      "properties": {
        "recipient": {"$ref": "#/$defs/recipient"}, "contributor": {"$ref": "#/$defs/contributor"},
        "candidate": {"$ref": "#/$defs/candidate"}, "conduit": {"$ref": "#/$defs/conduit"},
        "election": {"$ref": "#/$defs/election"}, "receipt": {"$ref": "#/$defs/receipt"},
        "filing": {"$ref": "#/$defs/filing"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "valid"}}}, "then": {"properties": {"issue_codes": {"maxItems": 0}}}},
    {"if": {"properties": {"state": {"const": "invalid"}}}, "then": {"properties": {"issue_codes": {"minItems": 1}}}}
  ]
}
