{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-tender.local/contracts/bundles/fec/candidate-itemized-individual-receipts/v1/manifest.schema.json",
  "title": "Candidate itemized-individual receipt fact bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "bundle_id", "bundle_type",
    "bundle_version", "publisher_version", "cycle", "source_release_id",
    "input_fact_sets", "run_id", "state", "published_at", "counts", "checks"
  ],
  "properties": {
    "$schema": {"const": "manifest.schema.json"},
    "schema_version": {"const": "legal-tender.fec.candidate-itemized-individual-receipts-fact-bundle.v1"},
    "bundle_id": {"$ref": "#/$defs/digest"},
    "bundle_type": {"const": "fec/candidate-itemized-individual-receipts"},
    "bundle_version": {"const": "1.0.0"},
    "publisher_version": {"const": "legal-tender.fec.candidate-itemized-individual-receipts-fact-bundle-publisher.v1"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source_release_id": {"type": "string", "pattern": "^fec-[a-f0-9]{64}$"},
    "input_fact_sets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fact_set"}
    },
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "ready"},
    "published_at": {"type": "string", "format": "date-time"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_a_facts", "candidate_committee_linkages",
        "all_candidates_summaries", "current_campaigns_summaries"
      ],
      "properties": {
        "schedule_a_facts": {"type": "integer", "minimum": 1},
        "candidate_committee_linkages": {"type": "integer", "minimum": 0},
        "all_candidates_summaries": {"type": "integer", "minimum": 0},
        "current_campaigns_summaries": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fact_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "dataset", "fact_type", "fact_set_id", "manifest_sha256"],
      "properties": {
        "role": {"enum": ["all_candidates_summary", "candidate_committee_linkage", "current_campaigns_summary", "schedule_a_receipts"]},
        "dataset": {"enum": ["all-candidates-summary", "candidate-committee-linkage", "current-campaigns-summary", "schedule-a"]},
        "fact_type": {"enum": ["fec.candidate_summary_all.v1", "fec.candidate_committee_linkage.v1", "fec.campaign_summary.v1", "fec.schedule_a_receipt.v1"]},
        "fact_set_id": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "severity", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["block", "warning"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
