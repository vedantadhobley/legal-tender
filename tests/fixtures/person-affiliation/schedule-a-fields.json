{
  "$schema": "layout.schema.json",
  "layout_id": "fec/schedule-a-45",
  "contract_version": "1.0.0",
  "status": "draft",
  "format_versions": ["8.3", "8.4", "8.5"],
  "record_family": "Schedule A itemized receipts; physical record type starts with SA and embeds the summary line reference",
  "logical_field_count": 45,
  "physical_field_policy": "Map at most the first 45 fields by sequence. Preserve the exact row, physical field count, explicit empty fields, omitted trailing fields, and any fields after sequence 45. Extra non-empty fields block normalization; extra empty fields are preserved and observed as a source-format variance.",
  "fields": [
    {"sequence": 1, "name": "form_type", "publisher_name": "FORM TYPE", "data_type": "A/N-8", "validation": "required error; SA[line reference], with SA3L for F3L", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 2, "name": "filer_committee_id_number", "publisher_name": "FILER COMMITTEE ID NUMBER", "data_type": "A/N-9", "validation": "required error", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 3, "name": "transaction_id", "publisher_name": "TRANSACTION ID", "data_type": "A/N-20", "validation": "required error; unique and uppercase for the life of original plus amendments", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 4, "name": "back_reference_transaction_id_number", "publisher_name": "BACK REFERENCE TRAN ID NUMBER", "data_type": "A/N-20", "validation": "optional reference to a related record transaction ID", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 5, "name": "back_reference_schedule_name", "publisher_name": "BACK REFERENCE SCHED NAME", "data_type": "A/N-8", "validation": "optional related schedule reference", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 6, "name": "entity_type", "publisher_name": "ENTITY TYPE", "data_type": "A/N-3", "validation": "required error; CAN, CCM, COM, IND, ORG, PAC, or PTY", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 7, "name": "contributor_organization_name", "publisher_name": "CONTRIBUTOR ORGANIZATION NAME", "data_type": "A/N-200", "validation": "required error when entity type is not IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 8, "name": "contributor_last_name", "publisher_name": "CONTRIBUTOR LAST NAME", "data_type": "A/N-30", "validation": "required error when entity type is IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 9, "name": "contributor_first_name", "publisher_name": "CONTRIBUTOR FIRST NAME", "data_type": "A/N-20", "validation": "required error when entity type is IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 10, "name": "contributor_middle_name", "publisher_name": "CONTRIBUTOR MIDDLE NAME", "data_type": "A/N-20", "validation": "optional for IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 11, "name": "contributor_prefix", "publisher_name": "CONTRIBUTOR PREFIX", "data_type": "A/N-10", "validation": "optional for IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 12, "name": "contributor_suffix", "publisher_name": "CONTRIBUTOR SUFFIX", "data_type": "A/N-10", "validation": "optional for IND or CAN", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 13, "name": "contributor_street_1", "publisher_name": "CONTRIBUTOR STREET 1", "data_type": "A/N-34", "validation": "required warning", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 14, "name": "contributor_street_2", "publisher_name": "CONTRIBUTOR STREET 2", "data_type": "A/N-34", "validation": "optional", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 15, "name": "contributor_city", "publisher_name": "CONTRIBUTOR CITY", "data_type": "A/N-30", "validation": "required warning", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 16, "name": "contributor_state", "publisher_name": "CONTRIBUTOR STATE", "data_type": "A/N-2", "validation": "required warning; FEC state code list", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 17, "name": "contributor_zip", "publisher_name": "CONTRIBUTOR ZIP", "data_type": "A/N-9", "validation": "required warning", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 18, "name": "election_code", "publisher_name": "ELECTION CODE", "data_type": "A/N-5", "validation": "optional G, P, R, S, C, E, or O plus YYYY", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 19, "name": "election_other_description", "publisher_name": "ELECTION OTHER DESCRIPTION", "data_type": "A/N-20", "validation": "required when election code is OYYYY", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 20, "name": "contribution_date", "publisher_name": "CONTRIBUTION DATE", "data_type": "NUM-8", "validation": "required warning; YYYYMMDD", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 21, "name": "contribution_amount", "publisher_name": "CONTRIBUTION AMOUNT {F3L Bundled}", "data_type": "AMT-12", "validation": "required warning", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 22, "name": "contribution_aggregate", "publisher_name": "CONTRIBUTION AGGREGATE {F3L Semi-annual Bundled}", "data_type": "AMT-12", "validation": "optional accumulator; cycle-to-date for F3/F3P, year-to-date for F3X, semi-annual bundled for F3L", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 23, "name": "contribution_purpose_description", "publisher_name": "CONTRIBUTION PURPOSE DESCRIP", "data_type": "A/N-100", "validation": "optional", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 24, "name": "contributor_employer", "publisher_name": "CONTRIBUTOR EMPLOYER", "data_type": "A/N-38", "validation": "required when donor aggregate exceeds 200 dollars", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 25, "name": "contributor_occupation", "publisher_name": "CONTRIBUTOR OCCUPATION", "data_type": "A/N-38", "validation": "required when donor aggregate exceeds 200 dollars", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 26, "name": "donor_committee_fec_id", "publisher_name": "DONOR COMMITTEE FEC ID", "data_type": "A/N-9", "validation": "conditional warning when entity type is CCM, PAC, or PTY", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 27, "name": "donor_committee_name", "publisher_name": "DONOR COMMITTEE NAME", "data_type": "A/N-200", "validation": "conditional warning when entity type is CCM, PAC, or PTY", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 28, "name": "donor_candidate_fec_id", "publisher_name": "DONOR CANDIDATE FEC ID", "data_type": "A/N-9", "validation": "conditional warning when entity type is CAN or CCM", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 29, "name": "donor_candidate_last_name", "publisher_name": "DONOR CANDIDATE LAST NAME", "data_type": "A/N-30", "validation": "conditional warning when entity type is CAN or CCM", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 30, "name": "donor_candidate_first_name", "publisher_name": "DONOR CANDIDATE FIRST NAME", "data_type": "A/N-20", "validation": "first and last both required when either is present", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 31, "name": "donor_candidate_middle_name", "publisher_name": "DONOR CANDIDATE MIDDLE NAME", "data_type": "A/N-20", "validation": "optional", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 32, "name": "donor_candidate_prefix", "publisher_name": "DONOR CANDIDATE PREFIX", "data_type": "A/N-10", "validation": "optional", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 33, "name": "donor_candidate_suffix", "publisher_name": "DONOR CANDIDATE SUFFIX", "data_type": "A/N-10", "validation": "optional", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 34, "name": "donor_candidate_office", "publisher_name": "DONOR CANDIDATE OFFICE", "data_type": "A/N-1", "validation": "conditional warning H, S, or P for CAN or CCM", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 35, "name": "donor_candidate_state", "publisher_name": "DONOR CANDIDATE STATE", "data_type": "A/N-2", "validation": "required when office is H or S", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 36, "name": "donor_candidate_district", "publisher_name": "DONOR CANDIDATE DISTRICT", "data_type": "NUM-2", "validation": "required when office is H", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 37, "name": "conduit_name", "publisher_name": "CONDUIT NAME", "data_type": "A/N-200", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 38, "name": "conduit_street_1", "publisher_name": "CONDUIT STREET1", "data_type": "A/N-34", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 39, "name": "conduit_street_2", "publisher_name": "CONDUIT STREET2", "data_type": "A/N-34", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 40, "name": "conduit_city", "publisher_name": "CONDUIT CITY", "data_type": "A/N-30", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 41, "name": "conduit_state", "publisher_name": "CONDUIT STATE", "data_type": "A/N-2", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 42, "name": "conduit_zip", "publisher_name": "CONDUIT ZIP", "data_type": "A/N-9", "validation": "optional conduit field", "form_associations": ["F3", "F3X", "F3P"]},
    {"sequence": 43, "name": "memo_code", "publisher_name": "MEMO CODE", "data_type": "A/N-1", "validation": "optional; X means true", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 44, "name": "memo_text_description", "publisher_name": "MEMO TEXT/DESCRIPTION", "data_type": "A/N-100", "validation": "optional", "form_associations": ["F3", "F3X", "F3P", "F3L"]},
    {"sequence": 45, "name": "account_system_code", "publisher_name": "Reference to SI or SL system code that identifies the Account", "data_type": "A/N-9", "validation": "must contain a valid Schedule I or L system code when supplied", "form_associations": ["F3", "F3X", "F3P"]}
  ]
}
